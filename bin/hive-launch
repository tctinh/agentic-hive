#!/usr/bin/env bash
# hive-launch — start or attach a persistent member session in tmux.
#
#   hive-launch <member> [claude|codex|omp] [dir] [-- harness args...]
#   hive-launch --list
#
# Members run as the `hive` account. When invoked by another user (the
# Beekeeper), re-executes itself through sudo.
#
# claude and codex integrate through command hooks declared in their own
# settings files. omp has no such file: it loads extensions from its agent
# directory, so Hive ships share/omp-hive.js and installs it there instead.
set -euo pipefail

HIVE_ROOT="${HIVE_ROOT:-/srv/hive}"
HIVE_USER="${HIVE_USER:-hive}"
SHARE="${HIVE_SHARE:-$(dirname "$(readlink -f "$0")")/../share/agentic-hive}"
[[ -d $SHARE ]] || SHARE="$(dirname "$(readlink -f "$0")")/../share"

die() { printf 'hive-launch: %s\n' "$*" >&2; exit 1; }

if [[ $(id -un) != "$HIVE_USER" ]]; then
  exec sudo -u "$HIVE_USER" -i -- hive-launch "$@"
fi

# Codex reads user-level hooks from ~/.codex/hooks.json. Prefer the host-managed
# CLI directory so the file (and Codex's trust hash for it) stays stable across
# host updates; fall back to whatever hive-hook is on PATH.
install_codex_hooks() {
  local hook="${HIVE_BIN_DIR:+${HIVE_BIN_DIR}/hive-hook}" f="$HOME/.codex/hooks.json" want
  [[ -n $hook && -x $hook ]] || hook=$(command -v hive-hook) || {
    echo "hive-launch: hive-hook not found; Codex runs without Room awareness" >&2
    return 0
  }
  want=$(jq -n --arg h "$hook" '
    def on($e): [{hooks: [{type: "command", command: "\($h) codex \($e)"}]}];
    {hooks: {
      SessionStart: on("SessionStart"),
      UserPromptSubmit: on("UserPromptSubmit"),
      PostToolUse: [{matcher: "*", hooks: [{type: "command", command: "\($h) codex PostToolUse"}]}],
      Stop: on("Stop"),
      SessionEnd: on("SessionEnd")
    }}')
  mkdir -p "$HOME/.codex"
  [[ -f $f && $(cat "$f") == "$want" ]] || printf '%s\n' "$want" >"$f"
}

# omp has no command-hook settings file: it loads extension modules from its
# agent directory. Install ours there so ambient discovery picks it up.
# PI_CODING_AGENT_DIR overrides that directory; otherwise it is ~/.omp/agent.
install_omp_extension() {
  local src="$SHARE/omp-hive.js" dest
  dest="${PI_CODING_AGENT_DIR:-$HOME/.omp/agent}/extensions/hive.js"
  if [[ ! -f $src ]]; then
    echo "hive-launch: extension missing: $src; omp runs without Room awareness" >&2
    return 0
  fi
  # Re-install in place on every launch so an upgraded Hive takes effect.
  if [[ -f $dest ]] && cmp -s "$dest" "$src"; then
    return 0
  fi
  mkdir -p "$(dirname "$dest")" 2>/dev/null || {
    echo "hive-launch: cannot write $dest; omp runs without Room awareness" >&2
    return 0
  }
  cp "$src" "$dest.tmp.$$" && chmod 0644 "$dest.tmp.$$" && mv -f "$dest.tmp.$$" "$dest"
}

# Inner mode: runs inside the tmux pane.
if [[ ${1:-} == --run ]]; then
  shift
  harness="$1"; shift
  # Keep members on the host's current CLI after host updates, rather than
  # inheriting this session's pinned package path for its lifetime.
  if [[ -n ${HIVE_BIN_DIR:-} && -x $HIVE_BIN_DIR/hive && $(readlink -f "$HIVE_BIN_DIR") != $(dirname "$(readlink -f "$0")") ]]; then
    export PATH="$HIVE_BIN_DIR:$PATH"
  fi
  case $harness in
    claude)
      claude --permission-mode auto --append-system-prompt "$(cat "$SHARE/member-instruction.md")" "$@" || true
      ;;
    codex)
      install_codex_hooks
      codex --approve-for-me --add-dir "$HIVE_ROOT" -c "developer_instructions=$(jq -Rs . <"$SHARE/member-instruction.md")" "$@" || true
      ;;
    omp)
      install_omp_extension
      # approvalMode already defaults to yolo, so members run unattended.
      omp --append-system-prompt "$(cat "$SHARE/member-instruction.md")" "$@" || true
      ;;
    *) die "unknown harness: $harness" ;;
  esac
  echo
  # ${HIVE_MEMBER:-unset}: under `set -u` an unset HIVE_MEMBER would otherwise
  # abort this line and lose the exit notice entirely.
  echo "[$harness exited — shell kept open; HIVE_MEMBER=${HIVE_MEMBER:-unset}]"
  exec bash -l
fi

if [[ ${1:-} == --list ]]; then
  tmux list-sessions -F '#S  created #{t:session_created}  #{?session_attached,attached,detached}' 2>/dev/null \
    | grep '^hive-' || echo "(no member sessions)"
  exit 0
fi

member="${1:-}"; [[ -n $member ]] || die "usage: hive-launch <member> [claude|codex|omp] [dir] [-- args...]"
shift
harness=claude
dir="$HIVE_ROOT/projects"
[[ $# -gt 0 && $1 != -- ]] && { harness="$1"; shift; }
[[ $# -gt 0 && $1 != -- ]] && { dir="$1"; shift; }
[[ ${1:-} == -- ]] && shift
[[ -d $dir ]] || die "no such directory: $dir"
dir=$(readlink -f "$dir")

# A public rename keeps the running environment and nest identity stable.
if resolved=$(hive _resolve "$member" 2>/dev/null); then member=$resolved; fi
[[ $member != beekeeper && ! -f $HIVE_ROOT/beekeepers/$member/state/beekeeper.json ]] || die "cannot launch a human Beekeeper identity"
hive join "$member" >/dev/null
session="hive-$member"

if ! tmux has-session -t "=$session" 2>/dev/null; then
  # Launch record: lets hive-member wake the member in the same place.
  jq -n --arg h "$harness" --arg d "$dir" --arg now "$(date --iso-8601=seconds)" \
    '{harness: $h, dir: $d, launched_at: $now}' >"$HIVE_ROOT/members/$member/state/launch.json"
  # The pane runs the harness directly, not a login shell, so anything the hive
  # user's profile exports would be lost. omp reads its agent directory from
  # PI_CODING_AGENT_DIR; a member pointed at the wrong one loses its config,
  # skills and credentials.
  tmux new-session -d -s "$session" -c "$dir" \
    -e "HIVE_MEMBER=$member" \
    -e "HIVE_ROOT=$HIVE_ROOT" \
    -e "HIVE_USER=$HIVE_USER" \
    -e "HIVE_BIN_DIR=${HIVE_BIN_DIR:-}" \
    -e "HIVE_SHARE=$SHARE" \
    -e "PI_CODING_AGENT_DIR=${PI_CODING_AGENT_DIR:-}" \
    -e "PATH=$PATH:$HIVE_ROOT/tools/bin" \
    -- "$0" --run "$harness" "$@"
  echo "hive-launch: started $session ($harness in $dir)"
fi

[[ -n ${HIVE_LAUNCH_NO_ATTACH:-} ]] && exit 0

if [[ -n ${TMUX:-} ]]; then
  exec tmux switch-client -t "=$session"
elif [[ -t 1 ]]; then
  exec tmux attach-session -t "=$session"
fi
