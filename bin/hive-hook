#!/usr/bin/env bash
# hive-hook <harness> <event> — harness adapter for Agentic Hive
# (claude, codex, opencode, antigravity).
#
# Installed as a lifecycle hook for SessionStart, UserPromptSubmit,
# PostToolUse, Stop and SessionEnd. Reads the hook JSON on stdin. Claude Code
# and Codex share the hookSpecificOutput.additionalContext output format; the
# OpenCode plugin (share/opencode) speaks that format too. Antigravity's
# native events and injectSteps output are translated below.
#
# Contract (SPEC §12): silent unless something new happened; never fails or
# blocks the harness; does nothing at all when HIVE_MEMBER is unset.
set -uo pipefail
umask 0002

harness="${1:-}"
event="${2:-}"
HIVE_ROOT="${HIVE_ROOT:-/srv/hive}"
export HIVE_DELIVERY_CACHE="${HIVE_DELIVERY_CACHE:-off}"
m="${HIVE_MEMBER:-}"
MAX_ENTRIES=12
SHARE="${HIVE_SHARE:-$(dirname "$(readlink -f "$0")")/../share/agentic-hive}"
[[ -f $SHARE/hive_runtime.py ]] || SHARE="$(dirname "$(readlink -f "$0")")/../share"

[[ -n $m && -f $HIVE_ROOT/.room-generation ]] || exit 0
[[ $m =~ ^[a-z0-9][a-z0-9._-]{0,63}$ ]] || exit 0

input=$(cat 2>/dev/null || true)
field() { jq -r "$1 // empty" <<<"$input" 2>/dev/null || true; }

# Process name of each harness, for telemetry PIDs.
process_name=$harness
[[ $harness != antigravity ]] || process_name=agy

# Antigravity (agy): translate native events into the shared lifecycle.
#   Launch                -> SessionStart telemetry only, from hive-launch
#   SessionStart          -> SessionStart (fires with the first prompt)
#   PreInvocation, n == 0 -> UserPromptSubmit (a new user turn)
#   PreInvocation, n > 0  -> PostToolUse (after the turn's tool calls)
#   PostToolUse           -> telemetry only; agy cannot inject context there
#   Stop                  -> Stop
# hive-launch assigns HIVE_AGY_SESSION so the member's session identity exists
# before agy creates a conversation; the conversation ID is kept for resume.
agy_launch=0 agy_instructions=0
if [[ $harness == antigravity ]]; then
  case $event in
    Launch) event=SessionStart; agy_launch=1 ;;
    SessionStart) agy_instructions=1 ;;
    PreInvocation)
      if [[ $(field .invocationNum) =~ ^[1-9][0-9]*$ ]]; then event=PostToolUse; else event=UserPromptSubmit; fi
      ;;
    PostToolUse) event=ToolUse ;;
  esac
  input=$(jq -c --arg ev "$event" --arg sid "${HIVE_AGY_SESSION:-}" '{
      hook_event_name: $ev,
      session_id: (if $sid != "" then $sid else .conversationId end),
      conversation_id: .conversationId,
      cwd: .cwd,
      tool_name: .toolCall.name
    } + (if $ev == "UserPromptSubmit" and (.lastUserInput | type) == "string" then {prompt: .lastUserInput} else {} end)
    | with_entries(select(.value != null))' <<<"${input:-"{}"}" 2>/dev/null) || input='{}'
fi

nest="$HIVE_ROOT/members/$m"
[[ -d $nest ]] || hive join "$m" >/dev/null 2>&1 || exit 0

read_int() {
  local v
  v=$(cat "$1" 2>/dev/null) || v=0
  [[ $v =~ ^[0-9]+$ ]] || v=0
  printf '%s' "$v"
}

cursor_file="$nest/state/last-delivered-generation"

# ------------------------------------------------------------- telemetry
# Passive and non-authoritative (SPEC §17). Failures are ignored.

live_harness_pid() { # walk up from the hook's parent to the outermost harness process
  local p=$PPID i comm found=""
  is_harness() { [[ $1 == "$process_name"* || $1 == ".$process_name"* || $1 == node* ]]; }
  for i in 1 2 3 4 5 6; do
    [[ -r /proc/$p/comm ]] || break
    comm=$(cat "/proc/$p/comm")
    if is_harness "$comm"; then
      found=$p
    elif [[ -n $found ]]; then
      break
    fi
    p=$(awk '/^PPid:/ {print $2}' "/proc/$p/status" 2>/dev/null) || break
    [[ $p -gt 1 ]] || break
  done
  # The outermost harness process (OpenCode's UI above its server, a Node
  # launcher above Codex) is the one the pane, dashboard and wake checks see.
  printf '%s' "$found"
}

telemetry() { # status
  local tfile="$HIVE_ROOT/telemetry/members/$m.json" cwd branch prev tmp pid prev_pid cur_pid started now
  mkdir -p "$(dirname "$tfile")" 2>/dev/null || return 0
  cwd=$(field .cwd); cwd=${cwd:-$PWD}
  local cache="$nest/state/git-context" cached_cwd cached_branch cached_at
  IFS=$'\t' read -r cached_at cached_cwd cached_branch 2>/dev/null <"$cache" || true
  [[ ${cached_at:-0} =~ ^[0-9]+$ ]] || cached_at=0
  branch=${cached_branch:-}
  if [[ ${cached_cwd:-} != "$cwd" || $event == SessionStart ]] || (($(date +%s) - ${cached_at:-0} >= 30)); then
    branch=$(timeout 0.1s git -C "$cwd" branch --show-current 2>/dev/null || true)
    printf '%s\t%s\t%s\n' "$(date +%s)" "$cwd" "$branch" >"$cache" 2>/dev/null || true
  fi
  prev=$(cat "$tfile" 2>/dev/null || echo '{}')
  jq -e . >/dev/null 2>&1 <<<"$prev" || prev='{}'
  prev_pid=$(jq -r '.pid // empty' <<<"$prev")
  cur_pid=$(live_harness_pid)
  now=$(date --iso-8601=seconds)
  if [[ $event == SessionEnd && -n $cur_pid && -n $prev_pid && $cur_pid != "$prev_pid" && -d /proc/$prev_pid ]]; then
    # A previous process's SessionEnd must not clobber a newer live session.
    return 0
  fi
  if [[ $event == SessionStart ]]; then
    pid=${cur_pid:-$PPID}; started=$now
  else
    # Re-bind to the live harness process whenever visible in /proc so missed
    # SessionStart or restart races do not leave telemetry stuck on an old PID.
    pid=${cur_pid:-${prev_pid:-$PPID}}
    started=$(jq -r '.started_at // empty' <<<"$prev")
    [[ -n $started ]] || started=$now
  fi
  tmp=$(mktemp "$tfile.XXXXXX") || return 0
  jq -n \
    --argjson prev "$prev" \
    --arg harness "$harness" --arg member "$m" --arg status "$1" --arg pid "$pid" \
    --arg started "$started" --arg now "$now" \
    --arg cwd "$cwd" --arg branch "$branch" --arg tool "$(field .tool_name)" \
    --arg session "$(field .session_id)" --arg conversation "$(field .conversation_id)" \
    --arg event "$event" --arg event_id "$(date +%s%N)" \
    --argjson delivered "$(read_int "$cursor_file")" '
      {
        member: $member,
        harness: $harness,
        status: $status,
        last_event: $event,
        event_id: $event_id,
        pid: ($pid | tonumber? // null),
        session_id: (if $session != "" then $session elif $event == "SessionStart" then null else $prev.session_id end),
        conversation_id: (if $conversation != "" then $conversation elif $event == "SessionStart" then null else $prev.conversation_id end),
        started_at: (if $started == "" then null else $started end),
        last_activity: $now,
        cwd: $cwd,
        git_branch: (if $branch == "" then null else $branch end),
        last_tool: (if $tool == "" then $prev.last_tool else $tool end),
        room_generation_delivered: $delivered
      }' >"$tmp" 2>/dev/null && chmod 0664 "$tmp" && mv -f "$tmp" "$tfile" || rm -f "$tmp"
}

# -------------------------------------------------------------- delivery

# Confirm terminal submission without retaining prompt contents. Kept separate
# from passive telemetry so overlapping hook events cannot overwrite it.
record_prompt() {
  local tmp hash marker
  jq -e '.prompt | type == "string"' <<<"$input" >/dev/null 2>&1 || return 0
  hash=$(jq -jr '
    .prompt
    | gsub("^\\s+|\\s+$"; "")
    | (try capture("^<pasted_content id=\"(?<id>[A-Za-z0-9_-]+)\">\n(?<body>[\\s\\S]*)\n</pasted_content(?: id=\"(?<cid>[A-Za-z0-9_-]+)\")?>$") catch null) as $m
    | if $m != null and ($m.cid == null or $m.cid == $m.id) then ($m.body | gsub("^\\s+|\\s+$"; "")) else . end
  ' <<<"$input" | sha256sum | cut -d' ' -f1) || return 0
  tmp=$(mktemp "$nest/state/last-submitted-prompt.XXXXXX") || return 0
  marker="$(date +%s%N) $hash"
  printf '%s\n' "$marker" >"$tmp" &&
    chmod 0664 "$tmp" && mv -f "$tmp" "$nest/state/last-submitted-prompt" || rm -f "$tmp"
  tmp=$(mktemp "$nest/state/last-submitted-prompt.json.XXXXXX") || return 0
  jq --arg receipt "$marker" '{receipt: $receipt, session_id: .session_id, event: "UserPromptSubmit"}' <<<"$input" >"$tmp" &&
    chmod 0664 "$tmp" && mv -f "$tmp" "$nest/state/last-submitted-prompt.json" || rm -f "$tmp"
}

emit() { # additionalContext for this event
  jq -n --arg ev "$event" --arg ctx "$1" \
    '{hookSpecificOutput: {hookEventName: $ev, additionalContext: $ctx}}'
}

# Unseen Room entries from peers, or nothing. Advances the cursor only after
# the entries were written to stdout.
message_helper() {
  local action="$1" code=0 temporary marker="$nest/state/$1-delivery-error.json"
  shift
  # Delivery always uses canonical JSONL metadata. The bounded allowance covers
  # cold history reads and contention; it is not a success signal.
  timeout 3s python3 "$SHARE/hive_messages.py" "$action" "$@" 2>/dev/null || code=$?
  if ((code)); then
    temporary=$(mktemp "$nest/state/.delivery-error.XXXXXX") || return 0
    if jq -n --arg action "$action" --arg event "$event" --arg at "$(date --iso-8601=seconds)" \
      --argjson code "$code" '{action:$action,event:$event,at:$at,exit_code:$code,receipt_confirmed:null}' >"$temporary"; then
      chmod 0664 "$temporary" && mv -f "$temporary" "$marker"
    else rm -f "$temporary"; fi
    printf 'hive-hook: %s helper exited %s; inspect %s and delivery receipts\n' "$action" "$code" "$marker" >&2
  else rm -f "$marker"; fi
  # Hooks remain non-fatal to the harness. Failure is visible and durable above.
  return 0
}

deliver() {
  local header="$1" signature
  if [[ -z $header && -f $nest/state/context-stamp ]]; then
    signature=$(stat -c '%i:%s:%y' "$HIVE_ROOT/messages.jsonl" "$HIVE_ROOT/channels.json" "$nest/state/delivery.json" 2>/dev/null) || signature=""
    [[ -z $signature ]] || signature=$'canonical-jsonl-v2\n'"$signature"
    [[ -z $signature || $signature != "$(cat "$nest/state/context-stamp" 2>/dev/null)" ]] || return 0
  fi
  exec 8>>"$nest/state/.deliver.lock" || return 0
  flock -n 8 || return 0
  # One delivery source. Migrated native sessions are explicitly skipped by
  # this helper; ROOM.md remains a view and is never another injector.
  printf '%s' "$header" | message_helper hook "$event"
  flock -u 8
}

session_header() {
  local claims mine=0 others=0 d owner lines="" notes_line=""
  for d in "$HIVE_ROOT"/claims/*/; do
    [[ -d $d ]] || continue
    owner=$(cat "$d/owner" 2>/dev/null || echo '?')
    if [[ $owner == "$m" ]]; then
      mine=$((mine + 1))
      lines+="  (yours) $(cat "$d/resource" 2>/dev/null)"$'\n'
    else
      others=$((others + 1))
      lines+="  $owner -> $(cat "$d/resource" 2>/dev/null)"$'\n'
    fi
  done
  if ((mine + others == 0)); then
    claims="No active claims."
  elif ((mine + others <= 10)); then
    claims="Active claims:"$'\n'"${lines%$'\n'}"
  else
    claims="$others claim(s) by peers, $mine by you (hive claims)."
  fi
  # Point to existing notes on resume; never inject their contents.
  if [[ -d $nest/notes ]] && find "$nest/notes" -type f -print -quit 2>/dev/null | grep -q .; then
    notes_line="working notes: $nest/notes (review after resume or compaction)"$'\n'
  fi
  printf 'HIVE\nmember: %s\nnest: %s\n%s%s\nRe-anchor on latest Beekeeper intent/current project direction after resume or compaction: solution open -> EXPLORE; solution selected -> COMMIT.\n' "$m" "$nest" "$notes_line" "$claims"
  profile_hint 1
}

profile_hint() {
  local file="$nest/state/profile.json" marker="$nest/state/last-profile-context" value name team
  [[ -f $file ]] || return 0
  local signature
  signature=$(stat -c '%i:%s:%Y:%Z' "$file" 2>/dev/null) || return 0
  [[ ${1:-0} == 1 || $(cat "$marker.signature" 2>/dev/null) != "$signature" ]] || return 0
  printf '%s\n' "$signature" >"$marker.signature" 2>/dev/null || true
  value=$(jq -c '{name,team,workdir}' "$file" 2>/dev/null) || return 0
  [[ ${1:-0} == 1 || $(cat "$marker" 2>/dev/null) != "$value" ]] || return 0
  name=$(jq -r '.name // empty' <<<"$value"); name=${name:-$m}
  team=$(jq -r '.team // empty' <<<"$value")
  printf 'HIVE member name: %s (session identity %s)' "$name" "$m"
  [[ -z $team ]] || printf '; team: @%s' "$team"
  printf '. Channels route subscribed context; requests name recipients. Routine updates stay passive. Use hive for current name/team routing. Use your current project/worktree; a saved working folder takes effect on wake/restart.\n'
  printf '%s\n' "$value" >"$marker" 2>/dev/null || true
}

# Codex writes rate limits into its session log (token_count events). Copy the
# latest non-empty snapshot to telemetry/quota/codex.json for the dashboard.
# Throttled to once per 30s; failures ignored.
codex_quota() {
  local attempt="$nest/state/quota-attempt"
  # Throttle the attempt before Python startup, including empty/failed reads.
  exec 6>>"$nest/state/.quota-attempt.lock" || return 0
  flock -n 6 || { exec 6>&-; return 0; }
  if (($(date +%s) - $(stat -c %Y "$attempt" 2>/dev/null || echo 0) < 30)); then
    flock -u 6; exec 6>&-; return 0
  fi
  touch "$attempt" 2>/dev/null || true
  flock -u 6; exec 6>&-
  timeout 0.3s python3 "$SHARE/hive_runtime.py" quota "$HIVE_ROOT" "$m" <<<"$input" 2>/dev/null || true
}

# Antigravity reports Gemini (normal) and Claude/GPT quota via `agy -p /usage`.
# Throttle on a shared stamp and refresh asynchronously with stdio detached so
# hooks return immediately.
antigravity_quota() {
  local qdir="$HIVE_ROOT/telemetry/quota" attempt="$HIVE_ROOT/telemetry/quota/.antigravity-attempt"
  mkdir -p "$qdir" 2>/dev/null || return 0
  exec 6>>"$qdir/.antigravity-attempt.lock" || return 0
  flock -n 6 || { exec 6>&-; return 0; }
  if (($(date +%s) - $(stat -c %Y "$attempt" 2>/dev/null || echo 0) < 60)); then
    flock -u 6; exec 6>&-; return 0
  fi
  touch "$attempt" 2>/dev/null || true
  flock -u 6; exec 6>&-
  (python3 "$SHARE/hive_runtime.py" antigravity-quota "$HIVE_ROOT" "$m" </dev/null >/dev/null 2>&1) &
}

# Epoch of this member's most recent Room entry, or nothing.
last_own_post() {
  tac "$HIVE_ROOT/ROOM.md" 2>/dev/null | gawk -v tail=" member=$m -->" '
    /^## / { ts = substr($0, 4); sub(/ — .*$/, "", ts); next }
    /^<!-- hive:entry gen=[0-9]+ member=/ {
      if (substr($0, length($0) - length(tail) + 1) == tail) { print ts; exit }
    }' | { read -r ts && date -d "$ts" +%s 2>/dev/null; }
}

# On a Beekeeper prompt, a one-line reminder when this member has been silent
# in the Room for a while (incident 2026-09-30: members started new work
# without announcing it). Deterministic: time since own last post only.
quiet_nudge() {
  local quiet="${HIVE_QUIET_MINUTES:-20}" last mins since
  ((quiet > 0)) || return 0
  last=$(last_own_post)
  if [[ -z $last ]]; then
    since="yet"
  else
    mins=$((($(date +%s) - last) / 60))
    ((mins >= quiet)) || return 0
    since="in ${mins}m"
  fi
  printf 'HIVE: no Room post from you %s. If this prompt starts shared work that may overlap a peer or changes shared direction, briefly announce what and where in the Room.\n' "$since"
}

core_hint() {
  local current marker="$nest/state/last-core-path-hint" bindir="${HIVE_BIN_DIR:-}"
  # Only meaningful when the host defines the always-current CLI directory and
  # this session's own hive lives somewhere else (e.g. a pinned package path).
  [[ -n $bindir && -x $bindir/hive ]] || return 0
  [[ $(dirname "$(readlink -f "$(dirname "$(readlink -f "$0")")/hive")") != $(dirname "$(readlink -f "$bindir/hive")") ]] || return 0
  current=$(readlink -f "$bindir/hive")
  [[ $(cat "$marker" 2>/dev/null) != "$current" ]] || return 0
  printf 'HIVE CLI: %s/hive tracks host updates; older running sessions may retain a pinned PATH. Its channel requests queue for safe boundaries. Ask human intent/taste questions with hive say "@beekeeper <question?>"; the WebUI highlights them and replies prompt your session. Preserve unresolved choices; continue only independent work while awaiting an answer.\n' "$bindir"
  printf '%s\n' "$current" >"$marker" 2>/dev/null || true
}

lifecycle() {
case $event in
  SessionStart)
    rm -f "$nest/state/quota-attempt" 2>/dev/null || true
    if ((agy_launch)); then
      # The pane is ready for input; nothing can be injected until a prompt.
      telemetry idle
      antigravity_quota
      return 0
    fi
    # Claude Code fires SessionStart at startup/resume/clear while sitting idle
    # at its prompt (Stop will not fire until a turn runs). Only mid-turn
    # compaction remains working.
    if [[ $harness == claude && $(field .source) != compact ]]; then
      telemetry idle
    else
      telemetry working
    fi
    deliver "$(session_header)"
    [[ $harness == antigravity ]] && antigravity_quota
    ;;
  UserPromptSubmit)
    record_prompt
    # Preserve exact evidence for an orphaned sender journal before a later
    # prompt replaces the single receipt slot. No cursor inference or input.
    timeout 0.3s python3 "$SHARE/hive_prompt.py" record-receipt <<<"$input" 2>/dev/null || true
    message_helper receipt <<<"$input"
    telemetry working
    deliver "$(
      core_hint
      profile_hint
      quiet_nudge
    )"
    ;;
  PostToolUse | PostToolUseFailure)
    telemetry working
    deliver "$(profile_hint)"
    [[ $harness == codex ]] && codex_quota
    [[ $harness == antigravity ]] && antigravity_quota
    ;;
  Stop | StopFailure)
    telemetry idle
    [[ $harness == codex ]] && codex_quota
    [[ $harness == antigravity ]] && antigravity_quota
    # A request can arrive after the final tool checkpoint. Attempt one drain
    # outside this hook; the normal locks, working state and draft guards apply.
    if [[ -f $nest/state/pending-wake.json ]]; then
      (python3 "$SHARE/hive_messages.py" drain "$m" >/dev/null 2>&1) </dev/null &
    fi
    ;;
  Notification)
    if [[ $(field .notification_type) == idle_prompt ]]; then
      telemetry idle
      if [[ -f $nest/state/pending-wake.json ]]; then
        (python3 "$SHARE/hive_messages.py" drain "$m" >/dev/null 2>&1) </dev/null &
      fi
    fi
    ;;
  ToolUse)
    telemetry working
    ;;
  SessionEnd)
    telemetry ended
    ;;
esac
return 0
}

if [[ $harness == antigravity ]]; then
  # Persist delivered context as system messages; always answer with JSON.
  extra=""
  ((agy_instructions)) && extra=$(cat "$SHARE/member-instruction.md" 2>/dev/null || true)
  lifecycle | jq -cs --arg extra "$extra" '
    ([$extra | select(. != "")] + [.[] | .hookSpecificOutput.additionalContext? // empty | select(. != "")]) as $context
    | if ($context | length) > 0 then {injectSteps: [$context[] | {systemMessage: {systemMessage: .}}]} else {} end' 2>/dev/null ||
    printf '{}\n'
else
  lifecycle
fi
exit 0
