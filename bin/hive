#!/usr/bin/env bash
# hive — Agentic Hive Core CLI.
# Deterministic convenience over plain files in $HIVE_ROOT (default /srv/hive).
# Everything it does can be inspected with cat/ls/rg; see SPEC.md.
set -euo pipefail
umask 0002

HIVE_ROOT="${HIVE_ROOT:-/srv/hive}"
HIVE_MEMBER_BIN="${HIVE_MEMBER_BIN:-${HIVE_SESSION_BIN:-hive-member}}"
ROOM="$HIVE_ROOT/ROOM.md"
GEN_FILE="$HIVE_ROOT/.room-generation"
ROOM_LOCK="$HIVE_ROOT/.room.lock"
MEMBER_HELPER="${HIVE_SHARE:-$(dirname "$(readlink -f "$0")")/../share/agentic-hive}/hive_members.py"
[[ -f $MEMBER_HELPER ]] || MEMBER_HELPER="$(dirname "$(readlink -f "$0")")/../share/hive_members.py"
MESSAGE_HELPER="${MEMBER_HELPER%/*}/hive_messages.py"

die() { printf 'hive: %s\n' "$*" >&2; exit 1; }
now() { date --iso-8601=seconds; }

usage() {
  cat <<'EOF'
usage:
  hive init
  hive join <member>
  hive say [--channel <name>] [--kind info|request|result|decision] [--to <member>]
           [--priority routine|urgent] [--id <retry-id>] [--reply-to <request-id>]
           [--task-id <task-id>] [--json] [--room-only] <message...>
  hive channel create|subscribe|unsubscribe|archive|reopen|pin <channel> [member]
  hive messages read <id> | history <channel> [--since N] | channels | flush <member>
  hive room [--last N] [--since-last] [--since G]
  hive observe
  hive claim <resource> [resource...]
  hive release <resource> [resource...]
  hive claims
  hive claim break <resource>
  hive delegate <target> --task <msg> [--worktree <dir>] [--branch <br>] [--claim <res>]
  hive delegate done [summary]
  hive delegate retry|cancel <target>
  hive message <member> <message...>  (wake or prompt another member)
  hive knowledge search <query...>

Member identity comes from $HIVE_MEMBER.
EOF
}

valid_member() { [[ $1 =~ ^[a-z0-9][a-z0-9._-]{0,63}$ ]]; }
is_beekeeper() { [[ $1 == beekeeper || -f $HIVE_ROOT/beekeepers/$1/state/beekeeper.json ]]; }
nest_dir() {
  if [[ $1 != beekeeper ]] && is_beekeeper "$1"; then printf '%s/beekeepers/%s' "$HIVE_ROOT" "$1"
  else printf '%s/members/%s' "$HIVE_ROOT" "$1"; fi
}

require_init() { [[ -f $GEN_FILE ]] || die "$HIVE_ROOT is not initialized (run: hive init)"; }

require_member() {
  local m="${HIVE_MEMBER:-}"
  [[ -n $m ]] || die "HIVE_MEMBER is not set"
  valid_member "$m" || die "invalid member name: $m"
  [[ -d $(nest_dir "$m") ]] || die "member '$m' has not joined (run: hive join $m)"
  printf '%s' "$m"
}

read_int() { # file -> integer (0 if missing/garbage)
  local v
  v=$(cat "$1" 2>/dev/null) || v=0
  [[ $v =~ ^[0-9]+$ ]] || v=0
  printf '%s' "$v"
}

generation() { read_int "$GEN_FILE"; }
cursor_file() { printf '%s/state/last-delivered-generation' "$(nest_dir "$1")"; }
cursor() { read_int "$(cursor_file "$1")"; }

atomic_write() { # path content
  local tmp
  tmp=$(mktemp "$1.XXXXXX")
  printf '%s\n' "$2" >"$tmp"
  chmod 0664 "$tmp"
  mv -f "$tmp" "$1"
}

# Highest generation actually present in ROOM.md. Guards against a crash
# between appending an entry and updating .room-generation.
room_last_gen() {
  tac "$ROOM" 2>/dev/null | sed -n 's/^<!-- hive:entry gen=\([0-9]\+\) member=[^ ]* -->$/\1/p;T;q' || true
}

# Print Room entries with generation > since, compactly.
#   $1 since   $2 exclude-member (or "")   $3 max entries (0 = all)
room_entries() {
  [[ -f $ROOM ]] || return 0
  local labels
  labels=$(python3 "$MEMBER_HELPER" list | jq -r '.members[] | [.member, .name, (.team // "")] | @tsv')
  gawk -v since="$1" -v exclude="$2" -v max="$3" -v maxlines=40 -v labels="$labels" '
    BEGIN {
      count = split(labels, rows, "\n")
      for (j = 1; j <= count; j++) {
        split(rows[j], fields, "\t")
        names[fields[1]] = fields[2]; teams[fields[1]] = fields[3]
      }
    }
    function flush(   n, s, i, out) {
      if (gen == "") return
      if (gen + 0 > since + 0 && member != exclude) {
        n = nb
        while (n > 0 && body[n] ~ /^[[:space:]]*$/) n--
        if (n > 0 && body[n] == "Generation: " gen) n--
        while (n > 0 && body[n] ~ /^[[:space:]]*$/) n--
        s = 1
        while (s <= n && body[s] ~ /^[[:space:]]*$/) s++
        author = names[member] != "" ? names[member] : member
        if (author != member) author = author " (" member ")"
        if (teams[member] != "") author = author " @" teams[member]
        out = sprintf("[%s] %s — %s\n", gen, author, ts)
        for (i = s; i <= n && i - s < maxlines; i++) out = out "    " body[i] "\n"
        if (n - s + 1 > maxlines) out = out "    … (truncated; full entry in ROOM.md)\n"
        entries[++ne] = out
        gens[ne] = gen
      }
      gen = ""; nb = 0; ts = ""
    }
    match($0, /^<!-- hive:entry gen=([0-9]+) member=([^ ]+) -->$/, m) {
      flush(); gen = m[1]; member = m[2]; state = 1; next
    }
    gen != "" && state == 1 && /^## / {
      ts = $0; sub(/^## /, "", ts); sub(/ — .*$/, "", ts); state = 2; next
    }
    gen != "" { body[++nb] = $0 }
    END {
      flush()
      first = 1
      if (max > 0 && ne > max) {
        first = ne - max + 1
        printf "(%d earlier entries omitted — see: hive room --since %d)\n\n", first - 1, since
      }
      for (i = first; i <= ne; i++) printf "%s", entries[i]
    }
  ' "$ROOM"
}

claim_dir() { # resource -> claim directory path
  local enc
  enc=$(jq -rn --arg r "$1" '$r|@uri')
  [[ $enc == .* ]] && enc="%2E${enc:1}"
  printf '%s/claims/%s' "$HIVE_ROOT" "$enc"
}

norm_resource() { # strip trailing slashes (but keep "/")
  local r="$1"
  while [[ $r == */ && $r != / ]]; do r="${r%/}"; done
  printf '%s' "$r"
}

# Two resources overlap if equal or one is a path prefix of the other.
overlaps() {
  local a b
  a=$(norm_resource "$1"); b=$(norm_resource "$2")
  [[ $a == "$b" || $b == "$a"/* || $a == "$b"/* ]]
}

notify() { # best-effort: flash a message in other members' tmux sessions
  local from="$1" s
  command -v tmux >/dev/null 2>&1 || return 0
  tmux list-sessions -F '#S' 2>/dev/null | while read -r s; do
    [[ $s == hive-* && $s != "hive-$from" ]] || continue
    tmux display-message -t "$s" "hive: new Room message from $from" 2>/dev/null || true
  done
  return 0
}

# ---------------------------------------------------------------- commands

cmd_init() {
  mkdir -p "$HIVE_ROOT"/{members,claims,knowledge,projects,tools/bin,telemetry/members,artifacts,history}
  [[ -e $ROOM ]] || printf '# Hive Room\n\n' >"$ROOM"
  [[ -e $GEN_FILE ]] || atomic_write "$GEN_FILE" 0
  [[ -e $ROOM_LOCK ]] || : >"$ROOM_LOCK"
  [[ -e $HIVE_ROOT/knowledge/INDEX.md ]] || cat >"$HIVE_ROOT/knowledge/INDEX.md" <<'EOF'
# Knowledge Vault

Curated, durable Hive knowledge. Not transcripts, not task status.
Add a line here when you add a file.
EOF
  chmod g+w "$ROOM" "$ROOM_LOCK" 2>/dev/null || true
  python3 "$MESSAGE_HELPER" init
  echo "hive: initialized $HIVE_ROOT (generation $(generation))"
}

cmd_join() {
  local m="${1:-}"
  [[ -n $m ]] || die "usage: hive join <member>"
  valid_member "$m" || die "invalid member name: $m (use lowercase letters, digits, . _ -)"
  require_init
  exec 8>>"$HIVE_ROOT/.members.lock"
  flock 8
  if [[ ! -d $HIVE_ROOT/members/$m ]] && ! is_beekeeper "$m"; then
    local roster; roster=$(python3 "$MEMBER_HELPER" list)
    if jq -e --arg m "$m" '(.teams | has($m)) or any(.members[]; .name == $m)' <<<"$roster" >/dev/null; then
      die "name '$m' is already a member name or team tag"
    fi
  fi
  local nest new=0; nest=$(nest_dir "$m")
  [[ -d $nest ]] || new=1
  mkdir -p "$nest"/{state,notes,scratch,artifacts}
  [[ -e $(cursor_file "$m") ]] || atomic_write "$(cursor_file "$m")" 0
  python3 "$MESSAGE_HELPER" join "$m" "$new"
  echo "hive: $m joined ($nest)"
  flock -u 8
}

cmd_say() {
  require_init
  local m; m=$(require_member)
  HIVE_MEMBER="$m" python3 "$MESSAGE_HELPER" post "$@"
}

cmd_room() {
  require_init
  local last="" since="" since_last=0 g
  while (($#)); do
    case $1 in
      --last) last="${2:?--last needs N}"; shift 2 ;;
      --since) since="${2:?--since needs a generation}"; shift 2 ;;
      --since-last) since_last=1; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  g=$(generation)
  if ((since_last)); then
    since=$(cursor "$(require_member)")
  elif [[ -z $since ]]; then
    since=$((g - ${last:-10})); ((since < 0)) && since=0
  fi
  room_entries "$since" "" 0
}

cmd_claims() {
  require_init
  local d any=0
  for d in "$HIVE_ROOT"/claims/*/; do
    [[ -d $d ]] || continue
    any=1
    printf '%s -> %s (since %s)\n' \
      "$(cat "$d/owner" 2>/dev/null || echo '?')" \
      "$(cat "$d/resource" 2>/dev/null || basename "$d")" \
      "$(cat "$d/created-at" 2>/dev/null || echo '?')"
  done
  ((any)) || echo "(no active claims)"
}

cmd_claim() {
  if [[ ${1:-} == break ]]; then shift; cmd_claim_break "$@"; return; fi
  require_init
  local m r d owner other created=()
  m=$(require_member)
  (($#)) || die "usage: hive claim <resource> [resource...]"
  exec 9>>"$HIVE_ROOT/.claims.lock"
  flock 9
  # Preflight the whole request so a conflict does not leave a partial batch.
  for r in "$@"; do
    [[ -n $r ]] || die "claim resources must not be empty"
    d=$(claim_dir "$r")
    if [[ -d $d ]]; then
      owner=$(cat "$d/owner" 2>/dev/null || echo '?')
      [[ $owner == "$m" ]] || die "'$r' is claimed by $owner since $(cat "$d/created-at" 2>/dev/null || echo '?') — coordinate in the Room, or 'hive claim break' if it is stale"
    fi
    for other in "$HIVE_ROOT"/claims/*/; do
      [[ -d $other && ${other%/} != "$d" ]] || continue
      owner=$(cat "$other/owner" 2>/dev/null || echo '?')
      [[ $owner == "$m" ]] && continue
      if overlaps "$r" "$(cat "$other/resource" 2>/dev/null)"; then
        die "'$r' overlaps '$(cat "$other/resource")' claimed by $owner — coordinate in the Room"
      fi
    done
  done
  for r in "$@"; do
    d=$(claim_dir "$r")
    if [[ -d $d ]]; then
      echo "hive: already yours: $r"
    elif mkdir "$d" 2>/dev/null; then
      created+=("$d")
      printf '%s\n' "$m" >"$d/owner"
      printf '%s\n' "$r" >"$d/resource"
      now >"$d/created-at"
      echo "hive: claimed $r"
    else
      for other in "${created[@]}"; do rm -f "$other"/{owner,resource,created-at}; rmdir "$other"; done
      die "could not claim '$r'"
    fi
  done
}

cmd_release() {
  require_init
  local m r d owner
  m=$(require_member)
  (($#)) || die "usage: hive release <resource> [resource...]"
  exec 9>>"$HIVE_ROOT/.claims.lock"
  flock 9
  for r in "$@"; do
    [[ -n $r ]] || die "release resources must not be empty"
    d=$(claim_dir "$r")
    [[ -d $d ]] || die "no claim on '$r'"
    owner=$(cat "$d/owner" 2>/dev/null || echo '?')
    [[ $owner == "$m" ]] || die "'$r' is held by $owner, not you (use 'hive claim break' if it is stale)"
  done
  for r in "$@"; do
    d=$(claim_dir "$r")
    [[ -d $d ]] || continue  # repeated argument
    rm -f "$d"/{owner,resource,created-at}
    rmdir "$d"
    echo "hive: released $r"
  done
}

cmd_claim_break() {
  require_init
  local m r d owner since
  m=$(require_member)
  r="${1:-}"; [[ -n $r && $# -eq 1 ]] || die "usage: hive claim break <resource>"
  exec 9>>"$HIVE_ROOT/.claims.lock"
  flock 9
  d=$(claim_dir "$r")
  [[ -d $d ]] || die "no claim on '$r'"
  owner=$(cat "$d/owner" 2>/dev/null || echo '?')
  since=$(cat "$d/created-at" 2>/dev/null || echo '?')
  rm -f "$d"/{owner,resource,created-at}
  rmdir "$d"
  echo "hive: broke claim on $r (was $owner since $since)"
  flock -u 9
  # Breaking a claim is never silent.
  cmd_say --room-only "Broke claim on \`$r\` (held by $owner since $since)." >/dev/null
}

cmd_observe() {
  require_init
  local m="${HIVE_MEMBER:-}" g c
  g=$(generation)
  echo "HIVE"
  if [[ -n $m && -d $(nest_dir "$m") ]]; then
    c=$(cursor "$m")
    echo "member: $m"
    echo "room: generation $g ($((g > c ? g - c : 0)) not yet delivered)"
  else
    echo "member: ${m:-(none)}"
    echo "room: generation $g"
  fi
  echo
  echo "CLAIMS"
  cmd_claims
  echo
  echo "RECENT ROOM"
  local since=$((g - 5)); ((since < 0)) && since=0
  room_entries "$since" "" 0
}

cmd_knowledge() {
  [[ ${1:-} == search ]] || die "usage: hive knowledge search <query...>"
  shift
  (($#)) || die "usage: hive knowledge search <query...>"
  local args=() w
  for w in "$@"; do args+=(-e "$w"); done
  rg -n -i -F --heading "${args[@]}" -- "$HIVE_ROOT/knowledge" || echo "(no matches)"
}

cmd_message() {
  require_init
  local m target; m=$(require_member)
  target="${1:-}"; (($#)) && shift
  [[ -n $target && $# -gt 0 ]] || die "usage: hive message <member> <message...>"
  HIVE_MEMBER="$m" python3 "$MESSAGE_HELPER" post --channel dm --kind request --to "$target" -- "$*"
}

cmd_delegate() {
  if [[ ${1:-} == done ]]; then shift; cmd_delegate_done "$@"; return; fi
  require_init
  local m
  m=$(require_member)

  # Check recursion depth limit (max depth = 1)
  local caller_state="$(nest_dir "$m")/state/delegation.json"
  if [[ -f $caller_state ]]; then
    local caller_depth
    caller_depth=$(jq -r '.depth // 0' "$caller_state" 2>/dev/null || echo 0)
    if ((caller_depth >= 1)); then
      die "cannot delegate: member '$m' is executing a delegated task (max depth = 1)"
    fi
  fi

  local target="${1:-}"
  [[ -n $target ]] || die "usage: hive delegate <target-member> --task <desc> [--worktree <dir>] [--branch <br>] [--claim <path>...]"
  shift
  valid_member "$target" || die "invalid target member name: $target"
  target=$(python3 "$MEMBER_HELPER" resolve "$target") || exit 1
  [[ -d $HIVE_ROOT/members/$target ]] || die "target member '$target' has not joined"
  [[ $target != "$m" ]] || die "cannot delegate task to yourself"

  local task="" worktree="" branch="" claims=()
  while (($#)); do
    case $1 in
      --task) task="${2:?--task requires text}"; shift 2 ;;
      --worktree) worktree="${2:?--worktree requires path}"; shift 2 ;;
      --branch) branch="${2:?--branch requires name}"; shift 2 ;;
      --claim) claims+=("${2:?--claim requires resource}"); shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done

  [[ -n $task ]] || die "--task is required"

  # Check target availability
  local tele_file="$HIVE_ROOT/telemetry/members/$target.json"
  if [[ -f $tele_file ]]; then
    local target_status last_act
    target_status=$(jq -r '.status // empty' "$tele_file" 2>/dev/null || echo "")
    last_act=$(jq -r '.last_activity // empty' "$tele_file" 2>/dev/null || echo "")
    if [[ $target_status == "working" && -n $last_act ]]; then
      local now_sec act_sec
      now_sec=$(date +%s)
      act_sec=$(date -d "$last_act" +%s 2>/dev/null || echo "$now_sec")
      if (((now_sec - act_sec) < 120)); then
        die "target member '$target' is currently busy (status: working). Wait or select an idle member."
      fi
    fi
  fi

  # Claims validation and transfer
  local res d other owner
  exec 9>>"$HIVE_ROOT/.claims.lock"
  flock 9
  for res in "${claims[@]}"; do
    d=$(claim_dir "$res")
    for other in "$HIVE_ROOT"/claims/*/; do
      [[ -d $other && ${other%/} != "$d" ]] || continue
      owner=$(cat "$other/owner" 2>/dev/null || echo '?')
      [[ $owner == "$m" || $owner == "$target" ]] && continue
      if overlaps "$res" "$(cat "$other/resource" 2>/dev/null)"; then
        die "claim collision: '$res' overlaps '$(cat "$other/resource")' claimed by $owner"
      fi
    done

    if [[ -d $d ]]; then
      owner=$(cat "$d/owner" 2>/dev/null || echo '?')
      [[ $owner == "$m" || $owner == "$target" ]] || die "claim collision: '$res' is held by $owner"
    fi
  done
  for res in "${claims[@]}"; do
    d=$(claim_dir "$res")
    if [[ ! -d $d ]]; then
      mkdir "$d" 2>/dev/null || die "could not claim '$res' for $target"
      printf '%s\n' "$res" >"$d/resource"
    fi
    printf '%s\n' "$target" >"$d/owner"
    now >"$d/created-at"
  done
  flock -u 9

  # Record delegation metadata
  mkdir -p "$HIVE_ROOT/members/$target/state"
  local target_state="$HIVE_ROOT/members/$target/state/delegation.json"
  local claims_json
  claims_json=$(jq -n '$ARGS.positional' --args "${claims[@]}")
  jq -n \
    --arg parent "$m" \
    --arg target "$target" \
    --arg task "$task" \
    --arg wt "$worktree" \
    --arg br "$branch" \
    --argjson claims "$claims_json" \
    --arg now "$(now)" \
    '{
      parent_member: $parent,
      target_member: $target,
      task: $task,
      worktree: (if $wt == "" then null else $wt end),
      branch: (if $br == "" then null else $br end),
      claims: $claims,
      delegated_at: $now,
      depth: 1
    }' >"$target_state"

  # Announce in ROOM.md
  local room_msg="DELEGATE -> $target: $task"
  [[ -n $worktree ]] && room_msg="$room_msg | worktree: $worktree"
  [[ -n $branch ]] && room_msg="$room_msg | branch: $branch"
  ((${#claims[@]})) && room_msg="$room_msg | claims: ${claims[*]}"
  cmd_say --room-only "$room_msg" >/dev/null

  # Deliver through the session lifecycle, including a prompt on a cold wake.
  local prompt="Delegated task from $m: $task"
  [[ -n $worktree ]] && prompt="$prompt (worktree: $worktree)"
  [[ -n $branch ]] && prompt="$prompt (branch: $branch)"

  "$HIVE_MEMBER_BIN" send "$target" "$prompt" || die "delegation recorded, but delivery to $target failed"

  echo "hive: delegated task to $target (depth: 1)"
}

cmd_delegate_done() {
  require_init
  local m
  m=$(require_member)
  local target_state="$(nest_dir "$m")/state/delegation.json"
  [[ -f $target_state ]] || die "no active delegation record found for member '$m'"

  local summary="${1:-subtask complete}"
  local parent
  parent=$(jq -r '.parent_member // "peer"' "$target_state" 2>/dev/null || echo "peer")

  # Release claims recorded in delegation.json if still held by this member
  local r d delegated_claims=()
  mapfile -t delegated_claims < <(jq -r '.claims[]? // empty' "$target_state" 2>/dev/null)
  exec 9>>"$HIVE_ROOT/.claims.lock"
  flock 9
  for r in "${delegated_claims[@]}"; do
    d=$(claim_dir "$r")
    if [[ -d $d && $(cat "$d/owner" 2>/dev/null || true) == "$m" ]]; then
      rm -f "$d"/{owner,resource,created-at}
      rmdir "$d" 2>/dev/null || true
    fi
  done
  flock -u 9

  # Archive delegation state
  mv -f "$target_state" "$(nest_dir "$m")/state/delegation.done.json"

  # Post DONE to Room
  cmd_say --room-only "DONE (delegated by $parent): $summary"
}

main() {
  local cmd="${1:-}"
  (($#)) && shift
  case $cmd in
    preflight) python3 "${MEMBER_HELPER%/*}/hive_runtime.py" preflight "$HIVE_ROOT" ;;
    init) cmd_init "$@" ;;
    join) cmd_join "$@" ;;
    say) cmd_say "$@" ;;
    room) cmd_room "$@" ;;
    observe) cmd_observe "$@" ;;
    claim) cmd_claim "$@" ;;
    release) cmd_release "$@" ;;
    claims) cmd_claims "$@" ;;
    delegate) cmd_delegate "$@" ;;
    message) cmd_message "$@" ;;
    messages) python3 "$MESSAGE_HELPER" "$@" ;;
    channel) python3 "$MESSAGE_HELPER" channel "$@" ;;
    knowledge) cmd_knowledge "$@" ;;
    # Used by harness adapters; not part of the agent-facing surface.
    _entries) room_entries "$@" ;;
    _resolve) python3 "$MEMBER_HELPER" resolve "$@" ;;
    -h | --help | help | "") usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
