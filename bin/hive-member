#!/usr/bin/env bash
# hive-member — lifecycle of Hive members (Beekeeper tool).
#
#   hive-member status [member]          what is running
#   hive-member wake <member> [--fresh] [--message <text>]
#                                         bring a member back, resuming its last
#                                         conversation, and attach (--fresh: new
#                                         conversation). Already running: attach.
#   hive-member restart <member> [--force] [--fresh] [--message <text>]
#                                         kill and wake (and attach); refuses while
#                                         the member is working unless --force
#   hive-member kill <member> [--force]  end the member's tmux session
#   hive-member delete <member> [--force]
#                                         remove its session, claims, nest and telemetry
#   hive-member send <member> <message> wake if needed and start work
#   hive-member rename <member> <name>  change its public name, preserving session
#   hive-member team <member> <team>    assign a team tag (empty string clears)
#   hive-member configure <member> [--name <name>] [--team <team>] [--dir <dir>]
#
# Harness, directory and conversation come from the member's launch record
# (members/<m>/state/launch.json, written by hive-launch) and telemetry.
set -euo pipefail

HIVE_ROOT="${HIVE_ROOT:-/srv/hive}"
HIVE_USER="${HIVE_USER:-hive}"
MEMBER_HELPER="${HIVE_SHARE:-$(dirname "$(readlink -f "$0")")/../share/agentic-hive}/hive_members.py"
[[ -f $MEMBER_HELPER ]] || MEMBER_HELPER="$(dirname "$(readlink -f "$0")")/../share/hive_members.py"
die() { printf 'hive-member: %s\n' "$*" >&2; exit 1; }
say() { printf 'hive-member: %s\n' "$*"; }

if [[ $(id -un) != "$HIVE_USER" ]]; then
  exec sudo -u "$HIVE_USER" -- env TERM="${TERM:-xterm-256color}" HIVE_ROOT="$HIVE_ROOT" "$0" "$@"
fi
unset TMUX

usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; }

tele() { jq -r "$2 // empty" "$HIVE_ROOT/telemetry/members/$1.json" 2>/dev/null || true; }
launch() { jq -r "$2 // empty" "$HIVE_ROOT/members/$1/state/launch.json" 2>/dev/null || true; }

has_session() { tmux has-session -t "=hive-$1" 2>/dev/null; }

# Follow the pane's process tree. Hook telemetry can retain an old PID after
# resume, so it must not decide whether wake/restart may replace a live agent.
process_alive() {
  local harness pid comm args checked=0 queue=() children=()
  harness=$(launch "$1" .harness); harness=${harness:-$(tele "$1" .harness)}
  [[ -n $harness ]] || return 1
  mapfile -t queue < <(tmux list-panes -t "=hive-$1" -F '#{pane_pid}' 2>/dev/null)
  while ((${#queue[@]} && checked < 256)); do
    pid=${queue[0]}; queue=("${queue[@]:1}")
    [[ $pid =~ ^[0-9]+$ ]] || continue
    checked=$((checked + 1))
    comm=$(cat "/proc/$pid/comm" 2>/dev/null || true)
    if [[ $comm == "$harness"* || $comm == ".$harness"* ]]; then return 0; fi
    if [[ $comm == node* ]]; then
      args=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
      [[ $args == *"/$harness"* ]] && return 0
    fi
    children=()
    [[ -r /proc/$pid/task/$pid/children ]] && read -r -a children <"/proc/$pid/task/$pid/children" || true
    queue+=("${children[@]}")
  done
  return 1
}
harness_alive() { has_session "$1" && process_alive "$1"; }

working() { # active in the last 2 minutes
  local last
  [[ $(tele "$1" .status) == working ]] || return 1
  last=$(tele "$1" .last_activity)
  [[ -n $last ]] && (($(date +%s) - $(date -d "$last" +%s) < 120))
}

state() {
  if harness_alive "$1"; then working "$1" && echo working || echo idle
  elif has_session "$1"; then echo "dead (tmux shell open)"
  elif [[ -f $HIVE_ROOT/telemetry/members/$1.json ]]; then echo dead
  else echo never; fi
}

require_member() {
  [[ -n ${1:-} ]] || { usage >&2; exit 2; }
  [[ $1 =~ ^[a-z0-9][a-z0-9._-]{0,63}$ ]] || die "invalid member name: $1"
  [[ $1 != beekeeper && ! -f $HIVE_ROOT/beekeepers/$1/state/beekeeper.json ]] || die "$1 is a human Beekeeper identity, not an agent session"
  [[ -d $HIVE_ROOT/members/$1 ]] || die "unknown member '$1' (members: $(ls "$HIVE_ROOT/members" | tr '\n' ' '))"
}

mark_ended() {
  local t="$HIVE_ROOT/telemetry/members/$1.json" tmp
  [[ -f $t ]] || return 0
  tmp=$(mktemp "$t.XXXXXX") && jq --arg now "$(date --iso-8601=seconds)" '.status = "ended" | .last_activity = $now' "$t" >"$tmp" &&
    chmod 0664 "$tmp" && mv -f "$tmp" "$t" || rm -f "${tmp:-}"
}

cmd_status() {
  local m name team
  while IFS=$'\t' read -r m name team; do
    [[ -z ${1:-} || $m == "$1" ]] || continue
    [[ $name == "$m" ]] || name="$name ($m)"
    [[ -z $team ]] || name="$name @$team"
    printf '%-24s %-24s %-7s %s\n' "$name" "$(state "$m")" "$(tele "$m" .harness || true)" "$(tele "$m" .session_id)"
  done < <(python3 "$MEMBER_HELPER" list | jq -r '.members[] | [.member, .name, (.team // "")] | @tsv')
}

cmd_kill() {
  local m="$1" force="$2"
  if working "$m" && harness_alive "$m" && ((!force)); then
    die "$m is working right now (active <2m ago); use --force to kill anyway"
  fi
  if has_session "$m"; then
    tmux kill-session -t "=hive-$m"
    say "killed hive-$m"
  else
    say "no tmux session for $m"
  fi
  mark_ended "$m"
}

cmd_delete() {
  local m="$1" force="$2" d owner
  exec 8>>"$HIVE_ROOT/.members.lock"
  flock 8
  [[ $m != beekeeper ]] || die "cannot delete the Beekeeper's Room identity"
  if harness_alive "$m" && ((!force)); then
    die "$m has a running agent; use --force to delete it"
  fi
  cmd_kill "$m" "$force"
  exec 9>>"$HIVE_ROOT/.claims.lock"
  flock 9
  for d in "$HIVE_ROOT"/claims/*/; do
    [[ -d $d ]] || continue
    owner=$(cat "$d/owner" 2>/dev/null || true)
    if [[ $owner == "$m" ]]; then rm -rf -- "$d"; fi
  done
  flock -u 9
  rm -f -- "$HIVE_ROOT/telemetry/members/$m.json"
  rm -rf -- "$HIVE_ROOT/members/$m"
  say "deleted $m (Room history retained)"
}

trim() { # strip leading/trailing whitespace, in place via name
  local s=${!1}
  s=${s#"${s%%[![:space:]]*}"}
  printf -v "$1" '%s' "${s%"${s##*[![:space:]]}"}"
}

composer() {
  local row line draft rows=()
  row=$(tmux display-message -p -t "=hive-$1:0.0" '#{cursor_y}') || return 1
  [[ $row =~ ^[0-9]+$ ]] || return 1
  mapfile -t rows < <(tmux capture-pane -p -t "=hive-$1:0.0")

  # omp draws the composer as a │ … │ box whose last row doubles as the bottom
  # border, so walking up from the cursor lands on a border, not on text. Take
  # the first row below the ╭ border: it is exactly the leading visual line of
  # the draft, which is what a wrapped paste still begins with. Joining every
  # wrapped row would not, because the line break eats the separating space.
  local i n t
  n=${#rows[@]}
  for ((i = n - 1; i >= 0; i--)); do
    [[ ${rows[i]} == '╭──'* ]] || continue
    ((i + 1 < n)) || break
    case ${rows[i + 1]} in
      '│'*'│') t=${rows[i + 1]#│}; t=${t%│} ;;
      '╰─'*) t=${rows[i + 1]#╰─}; t=${t%╯}; t=${t%─} ;;
      *) break ;;
    esac
    trim t
    printf '%s' "$t"
    return 0
  done

  # claude and codex: walk wrapped input up from the cursor, never search old
  # transcript prompts.
  for ((; row >= 0; row--)); do
    line=${rows[row]:-}
    case $line in
      '› '* | '❯ '*) printf '%s' "${line#* }"; return 0 ;;
      '  '*) ;;
      *) return 1 ;;
    esac
  done
  return 1
}

confirm_prompt() {
  local m="$1" message="$2" before="$3" retry="${4:-0}" before_draft="${5:-}" receipt hash draft attempt
  local entered=0 cleared=0 attempts=180
  local receipt_file="$HIVE_ROOT/members/$1/state/last-submitted-prompt"
  hash=$(printf '%s' "$message" | jq -Rrjs 'gsub("^\\s+|\\s+$"; "")' | sha256sum | cut -d' ' -f1)
  # UserPromptSubmit may run only when a busy harness processes queued input.
  # A guarded Enter followed by a stably reset composer confirms handoff now;
  # it does not claim the member has processed the message or completed work.
  ((retry)) && attempts=40
  for attempt in $(seq "$attempts"); do
    sleep 0.25
    receipt=$(cat "$receipt_file" 2>/dev/null || true)
    if [[ $receipt != "$before" && ${receipt#* } == "$hash" ]]; then
      say "sent message to $m (submission confirmed)"
      return 0
    fi
    # Submit/retry Enter only while our text remains in the composer. Never
    # repaste or send blind keystrokes into a dialog or an accepted turn.
    if ((retry)) && draft=$(composer "$m"); then
      # The visible first line may end at a newline or a narrow pane edge.
      # Match that literal prefix rather than requiring 32 visible characters.
      if [[ -n $draft && $message == "$draft"* ]] ||
         [[ $draft != "$before_draft" && ( $draft == '[Pasted Content '* || $draft == '[Pasted text '* ) ]]; then
        cleared=0
        if ((attempt % 4 == 0)); then
          tmux send-keys -t "=hive-$m:0.0" Enter || die "could not submit message to $m"
          entered=1
        fi
      elif ((entered)) && [[ $draft == "$before_draft" || -z $draft || $draft == 'Ask Codex to do anything' ]]; then
        cleared=$((cleared + 1))
        if ((cleared >= 2)) && harness_alive "$m"; then
          say "sent message to $m (accepted by harness; processing receipt pending)"
          return 0
        fi
      else
        cleared=0
      fi
    else
      cleared=0
    fi
  done
  printf 'hive-member: submission to %s is unconfirmed; inspect its terminal before resending\n' "$m" >&2
  return 2
}

send_prompt() {
  local m="$1" message="$2" buffer="hive-send-$$-$RANDOM" before before_draft ready=0
  harness_alive "$m" || die "$m has no running agent to receive the message"
  before=$(cat "$HIVE_ROOT/members/$m/state/last-submitted-prompt" 2>/dev/null || true)
  # A process can be alive while its TUI is still booting or showing a dialog.
  for _ in $(seq 40); do
    if before_draft=$(composer "$m"); then ready=1; break; fi
    sleep 0.25
  done
  ((ready)) || die "$m has no ready prompt composer; inspect its terminal"
  printf '%s' "$message" | tmux load-buffer -b "$buffer" - || die "could not load message for $m"
  tmux paste-buffer -d -p -r -b "$buffer" -t "=hive-$m:0.0" || die "could not paste message to $m"
  # Let the agent finish handling the bracketed paste before submitting.
  sleep 1
  confirm_prompt "$m" "$message" "$before" 1 "$before_draft"
}

cmd_wake() (
  local m="$1" fresh="$2" message="${3:-}" no_attach="${4:-0}" harness dir sid before args=()
  # Serialize the entire wake/paste/submit exchange, including cold starts.
  if [[ -n $message ]]; then
    exec 7>>"$HIVE_ROOT/members/$m/state/.prompt.lock"
    flock -w 90 7 || die "another prompt to $m is still being delivered"
  fi
  # A newly launched harness may not have fired SessionStart yet. Do not
  # mistake that short gap for a dead pane and kill it before it gets a prompt.
  if has_session "$m" && [[ -n $message ]] && ! harness_alive "$m"; then
    for _ in $(seq 20); do
      sleep 0.25
      harness_alive "$m" && break
    done
  fi
  if harness_alive "$m"; then
    if [[ -n $message ]]; then send_prompt "$m" "$message"
    else say "$m is already running ($(state "$m"))"; fi
    exec 7>&-
    ((no_attach)) || attach "$m"
    return 0
  fi
  # A pane left at a shell after the harness exited: replace it.
  has_session "$m" && tmux kill-session -t "=hive-$m"

  harness=$(launch "$m" .harness); harness=${harness:-$(tele "$m" .harness)}; harness=${harness:-claude}
  dir=$(jq -r '.workdir // empty' "$HIVE_ROOT/members/$m/state/profile.json" 2>/dev/null || true)
  dir=${dir:-$(launch "$m" .dir)}; dir=${dir:-$(tele "$m" .cwd)}; dir=${dir:-$HIVE_ROOT/projects}
  [[ -d $dir ]] || die "directory $dir no longer exists"
  sid=$(tele "$m" .session_id)

  if ((!fresh)) && [[ -n $sid ]]; then
    case $harness in
      claude|omp) args=(--resume "$sid") ;;
      codex) args=(resume "$sid") ;;
    esac
    say "waking $m ($harness in $dir), resuming conversation $sid"
  else
    say "waking $m ($harness in $dir) with a fresh conversation"
  fi
  [[ -z $message ]] || args+=("$message")
  before=$(cat "$HIVE_ROOT/members/$m/state/last-submitted-prompt" 2>/dev/null || true)
  HIVE_LAUNCH_NO_ATTACH=1 hive-launch "$m" "$harness" "$dir" -- "${args[@]}" 7>&-
  [[ -z $message ]] || confirm_prompt "$m" "$message" "$before"
  exec 7>&-
  ((no_attach)) || attach "$m"
)

# Attach when run from a terminal; otherwise just say how.
attach() {
  if [[ -t 0 && -t 1 ]]; then
    exec tmux attach-session -t "=hive-$1"
  fi
  say "attach with: hive-attach $1"
}

verb="${1:-}"; (($#)) && shift
if [[ $verb == rename || $verb == team || $verb == configure ]]; then
  target="${1:-}"; (($#)) && shift
  if [[ $verb == rename || $verb == team ]]; then
    [[ $# == 1 ]] || die "usage: hive-member $verb <member> <value>"
    option=--name; [[ $verb != team ]] || option=--team
    exec python3 "$MEMBER_HELPER" update "$target" "$option" "$1"
  fi
  exec python3 "$MEMBER_HELPER" update "$target" "$@"
fi
member="" force=0 fresh=0 message="" no_attach=0
if [[ $verb == send ]]; then
  member="${1:-}"; (($#)) && shift
  message="$*"
  [[ -n ${message//[[:space:]]/} ]] || die "usage: hive-member send <member> <message>"
  no_attach=1
else
  while (($#)); do
    case $1 in
      --force) force=1; shift ;;
      --fresh) fresh=1; shift ;;
      --no-attach) no_attach=1; shift ;;
      --message) [[ $# -ge 2 ]] || die "--message requires text"; message="$2"; shift 2 ;;
      -*) die "unknown option: $1" ;;
      *) [[ -z $member ]] || die "only one member may be specified"; member="$1"; shift ;;
    esac
  done
fi

if [[ -n $member && $member != beekeeper && ! -f $HIVE_ROOT/beekeepers/$member/state/beekeeper.json ]]; then
  member=$(python3 "$MEMBER_HELPER" resolve "$member") || exit 1
fi

case $verb in
  status | "") cmd_status "$member" ;;
  wake | send) require_member "$member"; cmd_wake "$member" "$fresh" "$message" "$no_attach" ;;
  kill) require_member "$member"; cmd_kill "$member" "$force" ;;
  delete) require_member "$member"; cmd_delete "$member" "$force" ;;
  restart)
    require_member "$member"
    cmd_kill "$member" "$force"
    for _ in $(seq 20); do process_alive "$member" || break; sleep 0.5; done
    process_alive "$member" && die "$member's process is still exiting; try wake in a moment"
    cmd_wake "$member" "$fresh" "$message" "$no_attach"
    ;;
  -h | --help | help) usage ;;
  *) usage >&2; exit 2 ;;
esac
