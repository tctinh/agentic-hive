#!/usr/bin/env python3
"""hive-web — Beekeeper dashboard and terminal over HTTP.

    hive-web [--address 0.0.0.0] [--port 8080]

GET /            the dashboard page (polls /api/state)
GET /api/state   JSON snapshot of members, claims, Room and host
GET /api/files   Browse projects, shared files, and member nests
GET /api/file    Preview or download one allowed file
POST /api/room-done  Dismiss one Beekeeper notification

Runs as the unprivileged hive user. Telemetry is a hint; process state wins.
"""

import argparse
import base64
import binascii
import fcntl
import hashlib
import json
from http.cookies import CookieError, SimpleCookie
import os
import pty
import pwd
import re
import select
import shutil
import signal
import struct
import subprocess
import sys
import termios
import threading
import time
from datetime import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, quote, unquote, urlparse

HIVE_ROOT = Path(os.environ.get("HIVE_ROOT", "/srv/hive"))
SHARE = Path(os.environ.get("HIVE_SHARE") or Path(__file__).resolve().parent.parent / "share/agentic-hive")
if not (SHARE / "dashboard.html").is_file():  # plain git checkout ships share/ directly
    SHARE = Path(__file__).resolve().parent.parent / "share"
WORKING_WINDOW = 120  # seconds of inactivity before "working" becomes "idle"
ROOM_TAIL_BYTES = 512 * 1024
ROOM_ENTRIES = 40
WS_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

ENTRY_RE = re.compile(r"^<!-- hive:entry gen=(\d+) member=(\S+) -->$")
MEMBER_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,63}$")
WEB_MEMBER = "beekeeper"
BIN_DIR = Path(__file__).resolve().parent
BEEKEEPER_LOCK = threading.Lock()
sys.path.insert(0, str(SHARE if (SHARE / "hive_members.py").is_file() else BIN_DIR.parent / "share"))
import hive_members


def is_beekeeper(member):
    return member == WEB_MEMBER or (HIVE_ROOT / "beekeepers" / member / "state/beekeeper.json").is_file()


def beekeeper_profiles():
    profiles = [{"member": WEB_MEMBER, "name": WEB_MEMBER}]
    for profile in sorted((HIVE_ROOT / "beekeepers").glob("*/state/beekeeper.json")):
        try:
            value = json.loads(profile.read_text())
            profiles.append({"member": profile.parent.parent.name, "name": value["name"]})
        except (OSError, ValueError, KeyError):
            continue
    return profiles


def ensure_beekeeper(name):
    """Self-chosen labels for trusted tailnet users, not authenticated accounts."""
    if not isinstance(name, str) or not re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,38}", name):
        raise ValueError("Use 1–39 lowercase letters, digits, dots, underscores or hyphens")
    member = f"beekeeper-{name}"
    with BEEKEEPER_LOCK:
        if (HIVE_ROOT / "members" / member).exists():
            raise ValueError("That name conflicts with an agent member; choose another")
        profile = HIVE_ROOT / "beekeepers" / member / "state/beekeeper.json"
        profile.parent.mkdir(parents=True, exist_ok=True)
        if not profile.exists():
            # Humans stay outside members/: older running CLIs must not wake them via @all.
            import tempfile
            fd, temporary = tempfile.mkstemp(dir=profile.parent, prefix=".beekeeper-")
            try:
                with os.fdopen(fd, "w") as stream:
                    json.dump({"name": name}, stream)
                os.replace(temporary, profile)
            finally:
                if os.path.exists(temporary):
                    os.unlink(temporary)
    return {"member": member, "name": name, "named": True}


def browser_beekeeper(headers):
    cookie = SimpleCookie()
    try:
        cookie.load(headers.get("Cookie", ""))
        name = cookie["hive_beekeeper"].value
        if re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,38}", name):
            member = f"beekeeper-{name}"
            if is_beekeeper(member):
                return {"member": member, "name": name, "named": True}
    except (CookieError, KeyError, ValueError):
        pass
    return {"member": WEB_MEMBER, "name": WEB_MEMBER, "named": False}


def read(path, default=""):
    try:
        return Path(path).read_text(errors="replace").strip()
    except OSError:
        return default


def iso_to_epoch(s):
    try:
        return datetime.fromisoformat(s).timestamp()
    except (TypeError, ValueError):
        return None


class Cpu:
    """CPU utilisation between successive samples of /proc/stat."""

    def __init__(self):
        self.lock = threading.Lock()
        self.prev = self._read()

    @staticmethod
    def _read():
        f = [int(x) for x in read("/proc/stat").splitlines()[0].split()[1:9]]
        idle = f[3] + f[4]
        return idle, sum(f)

    def percent(self):
        with self.lock:
            idle, total = self._read()
            didle, dtotal = idle - self.prev[0], total - self.prev[1]
            if dtotal < 50:  # too soon since the last sample; keep the old baseline
                return getattr(self, "last", None)
            self.prev = (idle, total)
            self.last = round(100 * (dtotal - didle) / dtotal)
            return self.last


CPU = Cpu()


def tmux_cmd(*args):
    user = os.environ.get("HIVE_USER", "hive")
    try:
        current_user = pwd.getpwuid(os.getuid()).pw_name
    except Exception:
        current_user = ""
    if current_user != user and shutil.which("sudo"):
        return ["sudo", "-u", user, "-n", "tmux"] + list(args)
    return ["tmux"] + list(args)


def set_winsize(fd, rows, cols):
    try:
        winsize = struct.pack("HHHH", rows, cols, 0, 0)
        fcntl.ioctl(fd, termios.TIOCSWINSZ, winsize)
    except Exception:
        pass


def make_ws_frame(payload, opcode=0x02):
    """Build an unmasked RFC 6455 WebSocket frame from server to client."""
    if isinstance(payload, str):
        payload = payload.encode("utf-8")
        opcode = 0x01
    length = len(payload)
    if length <= 125:
        header = bytes([0x80 | opcode, length])
    elif length <= 65535:
        header = bytes([0x80 | opcode, 126]) + struct.pack("!H", length)
    else:
        header = bytes([0x80 | opcode, 127]) + struct.pack("!Q", length)
    return header + payload


def read_ws_frame(sock):
    """Read and unmask an RFC 6455 frame from client."""
    def exact(length):
        data = bytearray()
        while len(data) < length:
            chunk = sock.recv(length - len(data))
            if not chunk:
                return None
            data.extend(chunk)
        return bytes(data)

    head = exact(2)
    if head is None:
        return None, None
    if len(head) < 2:
        return None, None
    b1, b2 = head[0], head[1]
    opcode = b1 & 0x0F
    is_masked = (b2 & 0x80) != 0
    length = b2 & 0x7F

    if length == 126:
        ext = exact(2)
        if ext is None:
            return None, None
        length = struct.unpack("!H", ext)[0]
    elif length == 127:
        ext = exact(8)
        if ext is None:
            return None, None
        length = struct.unpack("!Q", ext)[0]

    if length > 65536 or not is_masked or not (b1 & 0x80):
        raise ValueError("invalid WebSocket frame")
    mask = exact(4)
    data = exact(length)
    if mask is None or data is None:
        return None, None
    data = bytearray(data)

    if is_masked:
        for i in range(len(data)):
            data[i] ^= mask[i % 4]

    return opcode, bytes(data)


class TerminalBridge:
    def __init__(self, command, mode, sock, session_name=None, cwd=None, actor=None):
        self.command = command
        self.mode = mode
        self.sock = sock
        self.session_name = session_name
        self.cwd = cwd
        self.actor = actor
        self.running = True
        self.master_fd = None
        self.proc = None

    def start(self):
        self.master_fd, slave_fd = pty.openpty()
        set_winsize(self.master_fd, 30, 90)

        def terminal_session():
            os.setsid()
            # Resize and keyboard signals must reach the foreground terminal process.
            fcntl.ioctl(0, termios.TIOCSCTTY, 0)

        cmd = self.command
        env = os.environ.copy()
        env["TERM"] = "xterm-256color"
        env.pop("HIVE_MEMBER", None)
        if self.session_name is None and self.actor:
            env["HIVE_MEMBER"] = self.actor
            env["HIVE_ROOT"] = str(HIVE_ROOT)

        try:
            self.proc = subprocess.Popen(
                cmd,
                stdin=slave_fd,
                stdout=slave_fd,
                stderr=slave_fd,
                close_fds=True,
                env=env,
                cwd=self.cwd,
                preexec_fn=terminal_session,
            )
        except Exception as e:
            print(f"hive-web: failed to spawn {cmd}: {e}", flush=True)
            os.close(slave_fd)
            self.stop()
            return
        os.close(slave_fd)

        threading.Thread(target=self._pty_to_ws, daemon=True).start()
        threading.Thread(target=self._ws_to_pty, daemon=True).start()

    def _pty_to_ws(self):
        try:
            while self.running and self.proc.poll() is None:
                r, _, _ = select.select([self.master_fd], [], [], 0.1)
                if r:
                    data = os.read(self.master_fd, 4096)
                    if not data:
                        break
                    frame = make_ws_frame(data, opcode=0x02)
                    self.sock.sendall(frame)
        except Exception:
            pass
        finally:
            self.stop()

    def _ws_to_pty(self):
        try:
            while self.running:
                opcode, data = read_ws_frame(self.sock)
                if opcode is None or opcode == 0x08:  # Close
                    break
                if opcode == 0x09:  # Ping
                    self.sock.sendall(make_ws_frame(data, opcode=0x0A))  # Pong
                    continue

                if opcode in (0x01, 0x02):
                    try:
                        msg = json.loads(data.decode("utf-8"))
                        if msg.get("type") == "resize":
                            cols = int(msg.get("cols", 80))
                            rows = int(msg.get("rows", 24))
                            if cols >= 20 and rows >= 5:
                                set_winsize(self.master_fd, rows, cols)
                                # When steering, also resize the tmux window so the agent CLI refits to the viewer
                                if self.mode == "steer" and self.session_name:
                                    subprocess.run(tmux_cmd("set-window-option", "-t", self.session_name, "window-size", "manual"), capture_output=True)
                                    subprocess.run(tmux_cmd("resize-window", "-t", self.session_name, "-x", str(cols), "-y", str(rows)), capture_output=True)
                            continue
                        elif msg.get("type") == "input":
                            if self.mode == "steer":
                                input_data = msg.get("data", "")
                                os.write(self.master_fd, input_data.encode("utf-8"))
                            continue
                    except Exception:
                        pass
                    if self.mode == "steer":
                        os.write(self.master_fd, data)
        except Exception:
            pass
        finally:
            self.stop()

    def stop(self):
        if not self.running:
            return
        self.running = False
        try:
            if self.master_fd:
                os.close(self.master_fd)
        except Exception:
            pass
        if self.proc:
            try:
                os.killpg(self.proc.pid, signal.SIGTERM)
            except Exception:
                pass


def host():
    mem = {}
    for line in read("/proc/meminfo").splitlines():
        k, v = line.split(":", 1)
        mem[k] = int(v.split()[0]) * 1024
    disk = shutil.disk_usage(HIVE_ROOT)
    return {
        "hostname": os.uname().nodename,
        "cpu_percent": CPU.percent(),
        "cpus": os.cpu_count(),
        "load": [float(x) for x in read("/proc/loadavg").split()[:3]],
        "mem_total": mem.get("MemTotal"),
        "mem_used": mem.get("MemTotal", 0) - mem.get("MemAvailable", 0),
        "disk_total": disk.total,
        "disk_used": disk.used,
        "uptime": float(read("/proc/uptime", "0").split()[0]),
    }


def alive(pid, harness):
    if not isinstance(pid, int) or pid <= 1:
        return False
    comm = read(f"/proc/{pid}/comm")
    if not harness:
        return False
    if comm.startswith(harness) or comm.startswith("." + harness):
        return True
    return comm.startswith("node") and f"/{harness}" in read(f"/proc/{pid}/cmdline")


def member_panes():
    """Map each member session to its pane PID; telemetry may retain an old PID."""
    try:
        result = subprocess.run(tmux_cmd("list-panes", "-a", "-F", "#{session_name}\t#{pane_pid}"),
                                capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        return {}
    if result.returncode:
        return {}
    panes = {}
    for line in result.stdout.splitlines():
        session, sep, pid = line.partition("\t")
        if sep and pid.isdigit() and session.startswith("hive-"):
            panes[session[5:]] = int(pid)
    return panes


def pane_harness_pid(pane_pid, harness):
    """Find the agent underneath its tmux pane, including wrapped launchers."""
    pending = [pane_pid] if pane_pid else []
    seen = set()
    while pending and len(seen) < 256:
        pid = pending.pop()
        if pid in seen:
            continue
        seen.add(pid)
        if alive(pid, harness):
            return pid
        pending.extend(int(child) for child in read(f"/proc/{pid}/task/{pid}/children").split()
                       if child.isdigit())
    return None


def members(generation, now, room_entries):
    out = []
    panes = member_panes()
    last_posts = {}
    for entry in reversed(room_entries):
        last_posts.setdefault(entry["member"], entry)
    mdir = HIVE_ROOT / "members"
    profiles = {profile["member"]: profile for profile in hive_members.profiles(HIVE_ROOT)}
    for d in sorted(p for p in mdir.iterdir() if p.is_dir()) if mdir.is_dir() else []:
        name = d.name
        if is_beekeeper(name):
            continue
        try:
            t = json.loads(read(HIVE_ROOT / "telemetry/members" / f"{name}.json", "{}") or "{}")
        except json.JSONDecodeError:
            t = {}
        last = iso_to_epoch(t.get("last_activity"))
        try:
            launch = json.loads(read(d / "state/launch.json", "{}") or "{}")
        except json.JSONDecodeError:
            launch = {}
        harness = launch.get("harness") or t.get("harness") or ""
        live_pid = pane_harness_pid(panes.get(name), harness)
        if live_pid:
            recent = last is not None and now - last < WORKING_WINDOW
            state = "working" if t.get("status") == "working" and recent else "idle"
        elif not t and name not in panes:
            state = "never"
        else:
            state = "dead"
        cursor = read(d / "state/last-delivered-generation", "0")
        cursor = int(cursor) if cursor.isdigit() else 0
        cwd = t.get("cwd") or ""
        profile = profiles.get(name, {"name": name, "team": None, "workdir": None})
        out.append({
            "member": name,
            "name": profile["name"],
            "team": profile["team"],
            "workdir": profile["workdir"] or launch.get("dir") or cwd or str(HIVE_ROOT / "projects"),
            "state": state,
            "harness": harness or None,
            "pid": live_pid or t.get("pid"),
            "started_at": t.get("started_at"),
            "last_activity": t.get("last_activity"),
            "cwd": cwd,
            "cwd_short": cwd[len(str(HIVE_ROOT)) + 1:] if cwd.startswith(str(HIVE_ROOT) + "/") else cwd,
            "git_branch": t.get("git_branch"),
            "last_tool": t.get("last_tool"),
            "undelivered": max(0, generation - cursor),
            "notes": sorted(p.name for p in (d / "notes").glob("*") if p.is_file())[-5:],
            "last_room": last_posts.get(name),
        })
    return out


def claims():
    out = []
    cdir = HIVE_ROOT / "claims"
    for d in sorted(cdir.iterdir()) if cdir.is_dir() else []:
        if d.is_dir():
            out.append({
                "owner": read(d / "owner", "?"),
                "resource": read(d / "resource", unquote(d.name)),
                "created_at": read(d / "created-at") or None,
            })
    return out


def room(limit=ROOM_ENTRIES):
    path = HIVE_ROOT / "ROOM.md"
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - ROOM_TAIL_BYTES))
            text = f.read().decode(errors="replace")
    except OSError:
        return []
    entries, cur = [], None
    for line in text.splitlines():
        m = ENTRY_RE.match(line)
        if m:
            cur = {"gen": int(m[1]), "member": m[2], "ts": None, "body": []}
            entries.append(cur)
        elif cur is not None:
            if cur["ts"] is None and line.startswith("## "):
                cur["ts"] = line[3:].split(" — ", 1)[0]
            else:
                cur["body"].append(line)
    for e in entries:
        body = "\n".join(e["body"]).strip()
        body = re.sub(r"\n*Generation: %d\s*$" % e["gen"], "", body).strip()
        e["body"] = body
    return entries if limit is None else entries[-limit:]


PROJECT_CACHE = {"key": None, "at": 0, "value": []}
PROJECT_LOCK = threading.Lock()


def git_projects(paths):
    """Status for project roots and member worktrees, including idle members."""
    base = HIVE_ROOT / "projects"
    candidates = [str(base)]
    if base.is_dir():
        candidates += [str(p) for p in sorted(base.iterdir()) if p.is_dir() and not p.name.startswith(".")][:32]
    candidates += [p for p in paths if p]
    seen, out = set(), []

    def git(path, *args):
        try:
            result = subprocess.run(["git", "-C", path, *args], capture_output=True,
                                    text=True, timeout=4)
            return result.stdout.rstrip("\n") if result.returncode == 0 else None
        except (OSError, subprocess.SubprocessError):
            return None

    for candidate in candidates:
        if not os.path.isdir(candidate):
            continue
        top = git(candidate, "rev-parse", "--show-toplevel")
        if not top or top in seen:
            continue
        seen.add(top)
        branch = git(top, "symbolic-ref", "--quiet", "--short", "HEAD") or "(detached)"
        status = git(top, "status", "--porcelain=v1", "--untracked-files=normal")
        lines = status.splitlines() if status is not None else []
        staged = sum(line[:1] not in (" ", "?") for line in lines) if status is not None else None
        modified = sum(line[1:2] not in (" ", "?") for line in lines) if status is not None else None
        untracked = sum(line.startswith("??") for line in lines) if status is not None else None
        head = git(top, "log", "-1", "--date=iso-strict", "--format=%h%x1f%ad%x1f%s")
        commit = dict(zip(("hash", "date", "subject"), head.split("\x1f"))) if head else None
        counts = (git(top, "rev-list", "--left-right", "--count", "HEAD...@{upstream}") or "").split()
        behind, ahead = (int(counts[0]), int(counts[1])) if len(counts) == 2 else (None, None)
        out.append({"name": os.path.basename(top), "path": top, "branch": branch,
                    "staged": staged, "modified": modified, "untracked": untracked,
                    "ahead": ahead, "behind": behind, "commit": commit})
    return sorted(out, key=lambda p: p["path"])


def cached_git_projects(paths):
    key = (str(HIVE_ROOT), tuple(sorted(paths)))
    with PROJECT_LOCK:
        if PROJECT_CACHE["key"] != key or time.monotonic() - PROJECT_CACHE["at"] > 10:
            PROJECT_CACHE.update(key=key, at=time.monotonic(), value=git_projects(paths))
        return PROJECT_CACHE["value"]


def quota():
    """Account quota: hive-statusline (claude), hive-hook (codex), and the omp
    extension, which writes one file per provider that reports usage limits."""
    out = []
    qdir = HIVE_ROOT / "telemetry/quota"
    for f in sorted(qdir.glob("*.json")) if qdir.is_dir() else []:
        try:
            q = json.loads(f.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        windows = []
        for w in q.get("windows") or []:
            r = w.get("resets_at")
            if isinstance(r, (int, float)):  # epoch seconds
                r = datetime.fromtimestamp(r).astimezone().isoformat(timespec="seconds")
            windows.append({"name": w.get("name"), "used_percent": w.get("used_percent"), "resets_at": r})
        out.append({"harness": q.get("harness", f.stem), "provider": q.get("provider"),
                    "updated_at": q.get("updated_at"), "reported_by": q.get("reported_by"),
                    "plan": q.get("plan"), "windows": windows})
    return out


def state(viewer=None):
    now = time.time()
    g = read(HIVE_ROOT / ".room-generation", "0")
    generation = int(g) if g.isdigit() else 0
    all_room = room(limit=None)
    ms = members(generation, now, all_room)
    return {
        "hive_root": str(HIVE_ROOT),
        "now": datetime.now().astimezone().isoformat(timespec="seconds"),
        "generation": generation,
        "host": host(),
        "members": ms,
        "claims": claims(),
        "quota": quota(),
        "room": all_room[-ROOM_ENTRIES:],
        "beekeeper_mentions": beekeeper_mentions(all_room, viewer=viewer["member"] if viewer else WEB_MEMBER),
        "viewer": viewer,
        "beekeepers": beekeeper_profiles(),
        "teams": {team: [m["member"] for m in ms if m["team"] == team] for team in sorted({m["team"] for m in ms if m["team"]})},
        "projects": cached_git_projects([m["cwd"] for m in ms]),
    }


def room_done_path(generation, viewer=WEB_MEMBER):
    directory = "members" if viewer == WEB_MEMBER else "beekeepers"
    return HIVE_ROOT / directory / viewer / "state" / "room-done" / str(generation)


def beekeeper_mentions(posts, include_done=False, viewer=WEB_MEMBER):
    """Room mentions with human reply/dismissal context, without duplicating posts."""
    answered = set()
    for post in posts:
        if post["member"] == viewer:
            reply = re.match(r"^> Reply to ([a-z0-9][a-z0-9._-]{0,63}) · Room #(\d+):", post["body"])
            if reply:
                answered.add((reply[1], int(reply[2])))
    pending = []
    for post in posts:
        if is_beekeeper(post["member"]) or (not include_done and
                (room_done_path(post["gen"], viewer).is_file() or (post["member"], post["gen"]) in answered)):
            continue
        body = re.sub(r"^> Reply to [^\n]*\n\n", "", post["body"])
        names = {m.rstrip(".,;:") for m in re.findall(r"(?<![a-zA-Z0-9_./@-])@([a-z0-9][a-z0-9._-]{0,63})", body)}
        if viewer in names or WEB_MEMBER in names:
            pending.append({**post, "question": "?" in body or "？" in body,
                            "replied": (post["member"], post["gen"]) in answered})
    return pending


def run_hive(binary, *args, input_text=None, member=None, timeout=90):
    env = os.environ.copy()
    env["HIVE_ROOT"] = str(HIVE_ROOT)
    if member:
        env["HIVE_MEMBER"] = member
    result = subprocess.run(
        [str(BIN_DIR / binary), *args], input=input_text, text=True,
        capture_output=True, env=env, timeout=timeout,
    )
    if result.returncode:
        raise RuntimeError((result.stderr or result.stdout).strip() or f"{binary} failed")
    return result.stdout.strip()


def browser_path(path):
    """Resolve shared files, project artifacts, and member nest folders."""
    parts = path.split("/") if path else []
    if any(part in ("", ".", "..") for part in parts):
        raise ValueError("invalid file path")
    if not parts or parts == ["members"] or (len(parts) == 2 and parts[0] == "members" and MEMBER_RE.fullmatch(parts[1])):
        return None
    if parts[0] == "members":
        if len(parts) < 3 or not MEMBER_RE.fullmatch(parts[1]) or parts[2] not in ("notes", "artifacts", "scratch", "state"):
            raise ValueError("file path is outside member files")
        base = HIVE_ROOT.joinpath(*parts[:3])
    elif parts[0] in ("knowledge", "artifacts", "projects"):
        base = HIVE_ROOT / parts[0]
    elif parts == ["ROOM.md"]:
        base = HIVE_ROOT / "ROOM.md"
    else:
        raise ValueError("file path is outside Hive files")
    target = HIVE_ROOT.joinpath(*parts)
    if not base.resolve().is_relative_to(HIVE_ROOT.resolve()) or not target.resolve().is_relative_to(base.resolve()):
        raise ValueError("file path leaves its allowed folder")
    return target


def file_entries(path):
    browser_path(path)
    if not path:
        return [{"name": n, "path": n, "type": t} for n, t in
                (("ROOM.md", "file"), ("knowledge", "dir"), ("artifacts", "dir"), ("projects", "dir"), ("members", "dir"))]
    if path == "members":
        root = HIVE_ROOT / "members"
        return [{"name": p.name, "path": f"members/{p.name}", "type": "dir"}
                for p in sorted(root.iterdir()) if p.is_dir() and MEMBER_RE.fullmatch(p.name)] if root.is_dir() else []
    parts = path.split("/")
    if len(parts) == 2 and parts[0] == "members":
        return [{"name": n, "path": f"{path}/{n}", "type": "dir"}
                for n in ("notes", "artifacts", "scratch", "state") if (HIVE_ROOT / path / n).is_dir()]
    directory = browser_path(path)
    if not directory.is_dir():
        raise ValueError("folder not found")
    entries = []
    for child in sorted(directory.iterdir(), key=lambda p: (not p.is_dir(), p.name.lower())):
        try:
            browser_path(f"{path}/{child.name}")
            if not (child.is_dir() or child.is_file()):
                continue
            stat = child.stat()
        except (OSError, ValueError):
            continue
        entries.append({"name": child.name, "path": f"{path}/{child.name}",
                        "type": "dir" if child.is_dir() else "file", "size": stat.st_size,
                        "modified": datetime.fromtimestamp(stat.st_mtime).astimezone().isoformat(timespec="seconds")})
    return entries


def image_mime(data):
    if data.startswith(b"\x89PNG\r\n\x1a\n"):
        return "image/png"
    if data.startswith(b"\xff\xd8\xff"):
        return "image/jpeg"
    if data.startswith((b"GIF87a", b"GIF89a")):
        return "image/gif"
    if data.startswith(b"RIFF") and data[8:12] == b"WEBP":
        return "image/webp"
    return None


class Handler(BaseHTTPRequestHandler):
    server_version = "hive-web/0.1"

    def _send(self, code, body, ctype, headers=()):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        for name, value in headers:
            self.send_header(name, value)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(data)

    def _same_origin(self):
        origin = self.headers.get("Origin")
        return not origin or (urlparse(origin).scheme in ("http", "https")
                              and urlparse(origin).netloc == self.headers.get("Host"))

    def _json_request(self):
        length = int(self.headers.get("Content-Length", "0"))
        if not 0 < length <= 65536:
            raise ValueError("request size must be 1–65536 bytes")
        return json.loads(self.rfile.read(length).decode("utf-8"))

    def do_GET(self):
        viewer = browser_beekeeper(getattr(self, "headers", {}))
        url = urlparse(self.path)
        path = url.path
        if path in ("/ws/terminal", "/ws/shell"):
            self.handle_websocket(url)
            return
        if path in ("/", "/index.html"):
            page = (SHARE / "dashboard.html").read_text()
            try:  # first paint without waiting for the first poll
                initial = json.dumps(state(viewer)).replace("</", "<\\/")
                page = page.replace("/*__INITIAL_STATE__*/null", initial, 1)
            except Exception:
                pass
            self._send(200, page, "text/html; charset=utf-8")
        elif path == "/api/state":
            try:
                self._send(200, json.dumps(state(viewer)), "application/json")
            except Exception as e:  # never take the page down; report instead
                self._send(500, json.dumps({"error": str(e)}), "application/json")
        elif path in ("/api/files", "/api/file"):
            try:
                rel = parse_qs(url.query).get("path", [""])[0]
                if path == "/api/files":
                    offset = int(parse_qs(url.query).get("offset", ["0"])[0])
                    if offset < 0:
                        raise ValueError("invalid file offset")
                    entries = file_entries(rel)
                    end = offset + 300
                    self._send(200, json.dumps({"path": rel, "entries": entries[offset:end],
                                                 "next_offset": end if end < len(entries) else None}), "application/json")
                    return
                target = browser_path(rel)
                if target is None or not target.is_file():
                    raise ValueError("file not found")
                download = parse_qs(url.query).get("download") == ["1"]
                view = parse_qs(url.query).get("view") == ["1"]
                with target.open("rb") as source:
                    mime = image_mime(source.read(16))
                if view and not mime:
                    raise ValueError("inline preview is supported for raster images only")
                if download or view:
                    self.send_response(200)
                    self.send_header("Content-Type", mime if view else "application/octet-stream")
                    self.send_header("Content-Length", str(target.stat().st_size))
                    self.send_header("Content-Disposition", ("inline" if view else "attachment") + "; filename*=UTF-8''" + quote(target.name))
                    self.send_header("Cache-Control", "no-store")
                    self.send_header("X-Content-Type-Options", "nosniff")
                    self.end_headers()
                    if self.command != "HEAD":
                        with target.open("rb") as source:
                            shutil.copyfileobj(source, self.wfile)
                    return
                with target.open("rb") as source:
                    data = source.read(131073)
                binary = b"\0" in data or data.decode("utf-8", errors="replace").count("\ufffd") > 10
                self._send(200, json.dumps({"path": rel, "text": "" if binary else data[:131072].decode("utf-8", errors="replace"),
                                            "binary": binary, "truncated": len(data) > 131072,
                                            "size": target.stat().st_size, "image_mime": mime}), "application/json")
            except (OSError, ValueError) as exc:
                self._send(400, json.dumps({"error": str(exc)}), "application/json")
        elif path == "/static/xterm.js":
            p = SHARE / "xterm.js"
            if p.is_file():
                self._send(200, p.read_bytes(), "application/javascript")
            else:
                self._send(404, "not found\n", "text/plain")
        elif path == "/static/xterm.css":
            p = SHARE / "xterm.css"
            if p.is_file():
                self._send(200, p.read_bytes(), "text/css")
            else:
                self._send(404, "not found\n", "text/plain")
        elif path == "/healthz":
            self._send(200, "ok\n", "text/plain")
        else:
            self._send(404, "not found\n", "text/plain")

    def do_POST(self):
        if self.path in ("/api/steer", "/api/member", "/api/room", "/api/room-done", "/api/identity", "/api/member-profile"):
            if not self._same_origin():
                self._send(403, json.dumps({"ok": False, "error": "cross-origin request denied"}), "application/json")
                return
            try:
                req = self._json_request()
                viewer = browser_beekeeper(self.headers)
                actor_member = viewer["member"]
                if self.path == "/api/member-profile":
                    member = req.get("member")
                    if not isinstance(member, str) or not MEMBER_RE.fullmatch(member) or is_beekeeper(member):
                        raise ValueError("known agent member required")
                    for key in ("name", "team", "workdir"):
                        if key in req and not isinstance(req[key], str):
                            raise ValueError(f"{key} must be text")
                    profile = hive_members.update(HIVE_ROOT, member, name=req.get("name"), team=req.get("team"), workdir=req.get("workdir"))
                    self._send(200, json.dumps({"ok": True, "profile": profile}), "application/json")
                    return
                if self.path == "/api/identity":
                    name = req.get("name")
                    if isinstance(name, str):
                        name = name.strip().lower()
                    actor = ensure_beekeeper(name)
                    secure = "; Secure" if urlparse(self.headers.get("Origin", "")).scheme == "https" else ""
                    cookie = f'hive_beekeeper={actor["name"]}; Path=/; HttpOnly; SameSite=Lax; Max-Age=31536000{secure}'
                    self._send(200, json.dumps({"ok": True, "viewer": actor}), "application/json", (("Set-Cookie", cookie),))
                    return
                if self.path == "/api/room-done":
                    generation = req.get("generation")
                    if type(generation) is not int or generation < 1:
                        raise ValueError("valid Room generation required")
                    marker = room_done_path(generation, actor_member)
                    if not marker.is_file():
                        if not any(post["gen"] == generation for post in beekeeper_mentions(room(limit=None), include_done=True, viewer=actor_member)):
                            raise ValueError("Beekeeper mention not found")
                        marker.parent.mkdir(parents=True, exist_ok=True)
                        try:
                            marker.open("x").close()
                        except FileExistsError:
                            pass
                    self._send(200, json.dumps({"ok": True}), "application/json")
                    return
                if self.path == "/api/member":
                    member = req.get("member", "")
                    action = req.get("action", "")
                    if not MEMBER_RE.fullmatch(member) or is_beekeeper(member):
                        raise ValueError("known member required")
                    member = hive_members.resolve(HIVE_ROOT, member)
                    commands = {
                        "wake": ("wake", member, "--no-attach"),
                        "restart": ("restart", member, "--force", "--no-attach"),
                        "kill": ("kill", member, "--force"),
                        "delete": ("delete", member, "--force"),
                    }
                    if action not in commands:
                        raise ValueError("action must be wake, restart, kill or delete")
                    detail = run_hive("hive-member", *commands[action])
                    self._send(200, json.dumps({"ok": True, "detail": detail}), "application/json")
                    return
                if self.path == "/api/room":
                    body = req.get("message", "")
                    if not isinstance(body, str) or not body.strip() or len(body) > 12000:
                        raise ValueError("message must be 1–12000 characters")
                    if actor_member == WEB_MEMBER:
                        run_hive("hive", "join", WEB_MEMBER)
                    report = json.loads(run_hive("hive", "say", "--json", "-", input_text=body, member=actor_member, timeout=300))
                    self._send(200, json.dumps(report), "application/json")
                    return
                member = req.get("member", "")
                prompt = req.get("prompt", "")
                if not MEMBER_RE.fullmatch(member) or is_beekeeper(member):
                    raise ValueError("valid member name required")
                member = hive_members.resolve(HIVE_ROOT, member)
                if not isinstance(prompt, str) or not prompt.strip() or len(prompt) > 12000:
                    raise ValueError("prompt must be 1–12000 characters")

                named_prompt = f'Message from Beekeeper {actor_member} via dashboard (reply @{actor_member}; use hive for current Room routing): {prompt}' if viewer["named"] else prompt
                run_hive("hive-member", "send", member, named_prompt)

                self._send(200, json.dumps({"ok": True}), "application/json")
            except Exception as e:
                self._send(400, json.dumps({"ok": False, "error": str(e)}), "application/json")
            return
        self._send(404, "not found\n", "text/plain")

    def handle_websocket(self, url):
        if not self._same_origin():
            self._send(403, "cross-origin request denied\n", "text/plain")
            return
        if self.headers.get("Upgrade", "").lower() != "websocket":
            self._send(400, "websocket upgrade required\n", "text/plain")
            return
        qs = parse_qs(url.query)
        if url.path == "/ws/shell":
            mode = "steer"
            session_name = None
            command = [shutil.which("bash") or "/bin/bash", "-l"]
            cwd = str(HIVE_ROOT / "projects")
        else:
            member = qs.get("member", [""])[0]
            mode = qs.get("mode", ["steer"])[0]
            try:
                member = hive_members.resolve(HIVE_ROOT, member)
            except ValueError:
                self._send(400, "unknown member\n", "text/plain")
                return
            if mode not in ("watch", "steer"):
                self._send(400, "invalid terminal mode\n", "text/plain")
                return
            session_name = f"=hive-{member}"
            command = tmux_cmd("attach-session", *(["-r"] if mode == "watch" else []), "-t", session_name)
            cwd = None

        key = self.headers.get("Sec-WebSocket-Key", "")
        try:
            if len(base64.b64decode(key, validate=True)) != 16:
                raise ValueError
        except (ValueError, binascii.Error):
            self._send(400, "invalid websocket key\n", "text/plain")
            return
        accept_val = base64.b64encode(hashlib.sha1((key + WS_GUID).encode()).digest()).decode()

        # WebSocket upgrades require HTTP/1.1; keep ordinary HTTP responses unchanged.
        self.protocol_version = "HTTP/1.1"
        self.send_response(101, "Switching Protocols")
        self.send_header("Upgrade", "websocket")
        self.send_header("Connection", "Upgrade")
        self.send_header("Sec-WebSocket-Accept", accept_val)
        self.end_headers()

        actor = browser_beekeeper(self.headers)
        bridge = TerminalBridge(command, mode, self.request, session_name, cwd, actor=actor["member"] if actor["named"] else None)
        bridge.start()
        try:
            while bridge.running and (bridge.proc is None or bridge.proc.poll() is None):
                time.sleep(0.1)
        finally:
            bridge.stop()

    do_HEAD = do_GET

    def log_message(self, fmt, *args):
        pass  # polled every few seconds; keep the journal quiet


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--address", default=os.environ.get("HIVE_WEB_ADDRESS", "0.0.0.0"))
    ap.add_argument("--port", type=int, default=int(os.environ.get("HIVE_WEB_PORT", "8080")))
    ap.add_argument("--dump", action="store_true", help="print one /api/state snapshot and exit")
    a = ap.parse_args()
    if a.dump:
        time.sleep(0.3)
        print(json.dumps(state(), indent=2))
        return
    srv = ThreadingHTTPServer((a.address, a.port), Handler)
    print(f"hive-web: serving {HIVE_ROOT} on http://{a.address}:{a.port}/", flush=True)
    srv.serve_forever()


if __name__ == "__main__":
    main()
