{
  "statusLine": {
    "type": "command",
    "command": "/usr/bin/hive-statusline",
    "padding": 0
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "/usr/bin/hive-hook claude SessionStart" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "/usr/bin/hive-hook claude UserPromptSubmit" } ] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "/usr/bin/hive-hook claude PostToolUse" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "/usr/bin/hive-hook claude Stop" } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "/usr/bin/hive-hook claude SessionEnd" } ] }
    ]
  }
}
